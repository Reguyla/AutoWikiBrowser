<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.CustomModules.CSharpEvalWindow"
    Width="700"
    Height="420"
    MinWidth="560"
    MinHeight="340"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Title="C# Evaluator"
    Background="{DynamicResource TwainApplicationBackgroundBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,*,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <TextBlock
            Grid.Row="0"
            Text="C# expression"
            Foreground="{DynamicResource TwainTextPrimaryBrush}"
            FontSize="{DynamicResource TwainFontSizeNormal}" />

        <TextBox
            x:Name="ExpressionTextBox"
            Grid.Row="1"
            MinHeight="100"
            AcceptsReturn="True"
            AcceptsTab="True"
            TextWrapping="NoWrap"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            FontSize="{DynamicResource TwainFontSizeNormal}"
            Background="{DynamicResource TwainControlBackgroundBrush}"
            Foreground="{DynamicResource TwainTextPrimaryBrush}"
            BorderBrush="{DynamicResource TwainBorderBrush}"
            BorderThickness="{DynamicResource TwainBorderThickness}"
            CornerRadius="{DynamicResource TwainControlCornerRadius}" />

        <TextBlock
            Grid.Row="2"
            Text="Result"
            Foreground="{DynamicResource TwainTextPrimaryBrush}"
            FontSize="{DynamicResource TwainFontSizeNormal}" />

        <TextBox
            x:Name="ResultTextBox"
            Grid.Row="3"
            MinHeight="100"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="NoWrap"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            FontFamily="Cascadia Mono, Consolas, Courier New"
            FontSize="{DynamicResource TwainFontSizeNormal}"
            Background="{DynamicResource TwainControlBackgroundBrush}"
            Foreground="{DynamicResource TwainTextPrimaryBrush}"
            BorderBrush="{DynamicResource TwainBorderBrush}"
            BorderThickness="{DynamicResource TwainBorderThickness}"
            CornerRadius="{DynamicResource TwainControlCornerRadius}" />

        <StackPanel
            Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                x:Name="EvaluateButton"
                Width="100"
                Height="{DynamicResource TwainControlHeight}"
                Padding="{DynamicResource TwainControlPadding}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="_Evaluate"
                Background="{DynamicResource TwainAccentBrush}"
                Foreground="{DynamicResource TwainTextOnAccentBrush}"
                BorderBrush="{DynamicResource TwainAccentBrush}"
                BorderThickness="{DynamicResource TwainBorderThickness}"
                CornerRadius="{DynamicResource TwainControlCornerRadius}"
                Click="EvaluateButton_Click" />

            <Button
                Width="90"
                Height="{DynamicResource TwainControlHeight}"
                Padding="{DynamicResource TwainControlPadding}"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="_Close"
                Background="{DynamicResource TwainControlBackgroundBrush}"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                BorderBrush="{DynamicResource TwainBorderBrush}"
                BorderThickness="{DynamicResource TwainBorderThickness}"
                CornerRadius="{DynamicResource TwainControlCornerRadius}"
                Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>