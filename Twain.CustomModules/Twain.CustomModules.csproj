<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Twain.CustomModules</RootNamespace>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twain.Core\Twain.Core.csproj" />
    <ProjectReference Include="..\Twain.Diagnostics\Twain.Diagnostics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="Avalonia"
      Version="12.1.1" />

    <PackageReference
      Include="Avalonia.Desktop"
      Version="12.1.1" />

    <PackageReference
      Include="Avalonia.Themes.Fluent"
      Version="12.1.1" />

    <PackageReference
      Include="Avalonia.Fonts.Inter"
      Version="12.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="CustomModule.axaml.cs">
      <DependentUpon>CustomModule.axaml</DependentUpon>
    </Compile>

    <Compile Update="CustomModuleErrors.axaml.cs">
      <DependentUpon>CustomModuleErrors.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>