
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.ExternalPrograms.ExternalProgramWindow"
    Title="External Program"
    Width="600"
    Height="390"
    MinWidth="520"
    MinHeight="350"
    WindowStartupLocation="CenterOwner"
    CanResize="True"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- External processing options -->
        <CheckBox
            x:Name="EnabledCheckBox"
            Grid.Row="0"
            Content="Enable external program"
            Click="EnabledCheckBox_Changed" />

        <CheckBox
            x:Name="SkipCheckBox"
            Grid.Row="1"
            Content="Skip article when external processing makes no changes" />

        <!-- External program configuration -->
        <GroupBox
            x:Name="ConfigurationGroup"
            Grid.Row="2"
            Header="External program">

            <Grid
                Margin="12"
                RowDefinitions="Auto,Auto,Auto,Auto"
                ColumnDefinitions="Auto,*,Auto"
                RowSpacing="{DynamicResource TwainSpacingMedium}"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <!-- Program -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Program:" />

                <TextBox
                    x:Name="ProgramTextBox"
                    Grid.Row="0"
                    Grid.Column="1" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Classes="twain-command-button"
                    Content="Browse..."
                    Click="BrowseProgramButton_Click" />

                <!-- Parameters -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Parameters:" />

                <TextBox
                    x:Name="ParametersTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="2" />

                <!-- Input mode -->
                <StackPanel
                    Grid.Row="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource TwainSpacingLarge}">

                    <RadioButton
                        x:Name="FileModeRadioButton"
                        GroupName="InputMode"
                        Content="Pass article as file"
                        IsChecked="True"
                        Click="InputMode_Changed" />

                    <RadioButton
                        x:Name="ParameterModeRadioButton"
                        GroupName="InputMode"
                        Content="Pass article as parameter"
                        Click="InputMode_Changed" />

                </StackPanel>

                <!-- Input/output file -->
                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Input/output file:" />

                <TextBox
                    x:Name="OutputFileTextBox"
                    Grid.Row="3"
                    Grid.Column="1" />

                <Button
                    x:Name="BrowseOutputFileButton"
                    Grid.Row="3"
                    Grid.Column="2"
                    Classes="twain-command-button"
                    Content="Browse..."
                    Click="BrowseOutputFileButton_Click" />

            </Grid>
        </GroupBox>

        <!-- Commands -->
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Classes="twain-primary-button"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</Window>
