
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.Lists.Providers.SpecialPageListProviderWindow"
    Title="Special Pages"
    Width="420"
    Height="220"
    MinWidth="360"
    MinHeight="220"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        ColumnDefinitions="Auto,*"
        RowSpacing="{DynamicResource TwainSpacingMedium}"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Source selection -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Source:" />

        <ComboBox
            x:Name="SourceComboBox"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Stretch"
            SelectionChanged="SourceComboBox_SelectionChanged" />

        <!-- Page count -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Pages:" />

        <TextBox
            x:Name="PagesTextBox"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Stretch" />

        <!-- Namespace selection -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Namespace:" />

        <ComboBox
            x:Name="NamespaceComboBox"
            Grid.Row="2"
            Grid.Column="1"
            HorizontalAlignment="Stretch" />

        <!-- Commands -->
        <StackPanel
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Classes="twain-primary-button"
                Content="OK"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</Window>
