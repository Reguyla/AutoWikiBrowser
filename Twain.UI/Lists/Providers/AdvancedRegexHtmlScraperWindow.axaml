
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.Lists.Providers.AdvancedRegexHtmlScraperWindow"
    Title="Advanced Regex HTML Scraper"
    Width="500"
    Height="260"
    MinWidth="440"
    MinHeight="240"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="Auto,*"
        RowSpacing="{DynamicResource TwainSpacingMedium}"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Regular expression -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Regex:" />

        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBox
                x:Name="RegexTextBox"
                HorizontalAlignment="Stretch" />

            <Button
                Classes="twain-command-button"
                HorizontalAlignment="Left"
                Content="Open in Regex Tester"
                Click="OpenRegexTesterButton_Click" />

        </StackPanel>

        <!-- Capture group -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Group:" />

        <NumericUpDown
            x:Name="GroupNumberInput"
            Grid.Row="1"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Width="100"
            Minimum="0"
            Maximum="1000"
            Increment="1" />

        <!-- Regex options -->
        <CheckBox
            x:Name="CaseSensitiveCheckBox"
            Grid.Row="2"
            Grid.Column="1"
            Content="Case Sensitive" />

        <CheckBox
            x:Name="SingleLineCheckBox"
            Grid.Row="3"
            Grid.Column="1"
            Content="SingleLine" />

        <CheckBox
            x:Name="MultiLineCheckBox"
            Grid.Row="4"
            Grid.Column="1"
            VerticalAlignment="Top"
            Content="MultiLine" />

        <!-- Validation message -->
        <TextBlock
            x:Name="ValidationMessageTextBlock"
            Grid.Row="5"
            Grid.ColumnSpan="2"
            IsVisible="False"
            TextWrapping="Wrap" />

        <!-- Commands -->
        <StackPanel
            Grid.Row="6"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Classes="twain-primary-button"
                Content="OK"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</Window>
