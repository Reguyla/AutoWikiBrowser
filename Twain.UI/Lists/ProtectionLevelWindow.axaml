<Window
    x:Class="Twain.UI.Controls.Lists.ProtectionLevelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="220"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Protection">

    <Grid Margin="16"
          RowDefinitions="*,Auto"
          ColumnDefinitions="*,*"
          RowSpacing="12"
          ColumnSpacing="12">

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Spacing="6">

            <TextBlock Text="Type"
                       FontWeight="SemiBold" />

            <ListBox x:Name="TypeListBox"
                     SelectedIndex="0">
                <ListBoxItem Content="Edit protection" />
                <ListBoxItem Content="Move protection" />
                <ListBoxItem Content="Edit &amp; Move protection" />
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="0"
                    Grid.Column="1"
                    Spacing="6">

            <TextBlock Text="Level"
                       FontWeight="SemiBold" />

            <ListBox x:Name="LevelListBox"
                     SelectedIndex="0">
                <ListBoxItem Content="Autoconfirmed" />
                <ListBoxItem Content="Sysop" />
                <ListBoxItem Content="Autoconfirmed &amp; Sysop" />
            </ListBox>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button Content="_OK"
                    Width="90"
                    IsDefault="True"
                    Click="OkButton_Click" />

            <Button Content="_Cancel"
                    Width="90"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>