
<Window
    x:Class="Twain.UI.Controls.Lists.ProtectionLevelWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="220"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Protection"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        ColumnDefinitions="*,*"
        RowSpacing="{DynamicResource TwainSpacingMedium}"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Protection type -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Text="Type"
                FontWeight="SemiBold" />

            <ListBox
                x:Name="TypeListBox"
                Classes="twain-listbox"
                SelectedIndex="0">

                <ListBoxItem Content="Edit protection" />
                <ListBoxItem Content="Move protection" />
                <ListBoxItem Content="Edit &amp; Move protection" />

            </ListBox>
        </StackPanel>

        <!-- Protection level -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Text="Level"
                FontWeight="SemiBold" />

            <ListBox
                x:Name="LevelListBox"
                Classes="twain-listbox"
                SelectedIndex="0">

                <ListBoxItem Content="Autoconfirmed" />
                <ListBoxItem Content="Sysop" />
                <ListBoxItem Content="Autoconfirmed &amp; Sysop" />

            </ListBox>
        </StackPanel>

        <!-- Completion commands -->
        <StackPanel
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Classes="twain-primary-button"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</Window>
