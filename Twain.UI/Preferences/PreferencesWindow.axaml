<UserControl
    x:Class="Twain.UI.Preferences.PreferencesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid RowDefinitions="*,Auto">

        <TabControl
            x:Name="PreferencesTabs"
            Classes="twain-tabs"
            Grid.Row="0"
            Margin="{DynamicResource TwainContentPadding}">

           <TabItem Classes="twain-tab" Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Margin="{DynamicResource TwainContentPadding}"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                <TextBlock Classes="twain-section-heading" Text="Appearance" />

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    Margin="0,4,0,0">

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Select theme:" />


                        <ComboBox
                            x:Name="ThemeComboBox"
                            Grid.Column="1"
                            MinWidth="240"
                            SelectionChanged="ThemeComboBox_SelectionChanged">

                            <ComboBoxItem Content="Classic (Original)" />
                            <ComboBoxItem Content="Legacy (AWB-inspired)" />

                        </ComboBox>


                </Grid>
                
                <CheckBox
                    x:Name="ShowProcessingToolbarCheckBox"
                    Content="Show processing toolbar"
                    IsChecked="True"
                    Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
<TextBlock Classes="twain-section-heading" Text="Application processing" />

                <CheckBox
                    x:Name="MinimizeCheckBox"
                    Content="Minimize to notification area (systray)" />

                <CheckBox
                    x:Name="ConfirmExitCheckBox"
                    Content="Warn on exit" />

                <CheckBox
                    x:Name="ShowTimerCheckBox"
                    Content="Display moving average timer" />

                <CheckBox
                    x:Name="ClearPageListOnProjectChangeCheckBox"
                    Grid.Row="8"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="Empty page list on project change" />

                <CheckBox
                    x:Name="LowThreadPriorityCheckBox"
                    Content="Low thread priority (works better in background)" />

                <Grid
                    ColumnDefinitions="Auto,*"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    Margin="0,4,0,0">

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="On load:" />

                    <ComboBox
                        x:Name="OnLoadComboBox"
                        Grid.Column="1"
                        MinWidth="240"
                        SelectionChanged="OnLoadComboBox_SelectionChanged">

                        <ComboBoxItem Content="Show changes" />
                        <ComboBoxItem Content="Start bot mode" />

                    </ComboBox>

                </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
<TextBlock Classes="twain-section-heading" Text="Bot processing" />

                <CheckBox
                    x:Name="DiffInBotModeCheckBox"
                    Content="Preview the Diff in Bot Mode" />

                <CheckBox
                    x:Name="IgnoreNoBotsCheckBox"
                    Grid.Row="7"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="Ignore {{bots}} and {{nobots}} restrictions" />
                    </StackPanel>
                </Border>

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
<TextBlock Classes="twain-section-heading" Text="Logging" />

                <CheckBox
                    x:Name="LoggingCheckBox"
                    Content="Enable Logging" />
                    </StackPanel>
                </Border>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Site">
                <Border Classes="twain-section" Margin="{DynamicResource TwainContentPadding}">
                <Grid
                    ColumnDefinitions="Auto,*"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Project:" />

                    <ComboBox
                        x:Name="ProjectComboBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        MinWidth="240"
                        SelectionChanged="ProjectComboBox_SelectionChanged" />

                    <TextBlock
                        x:Name="LanguageLabel"
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Language:" />

                    <ComboBox
                        x:Name="LanguageComboBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        MinWidth="240" />

                    <TextBlock
                        x:Name="CustomProjectLabel"
                        Grid.Row="2"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Custom project:" />

                    <ComboBox
                        x:Name="CustomProjectComboBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        MinWidth="240"
                        IsEditable="True"
                        LostFocus="CustomProjectComboBox_LostFocus" />

                    <TextBlock
                        x:Name="ProtocolLabel"
                        Grid.Row="3"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Protocol:" />

                    <ComboBox
                        x:Name="ProtocolComboBox"
                        Grid.Row="3"
                        Grid.Column="1"
                        MinWidth="160">
                        <ComboBoxItem Content="https://" />
                        <ComboBoxItem Content="http://" />
                    </ComboBox>

                    <TextBlock
                        x:Name="PostfixLabel"
                        Grid.Row="4"
                        Grid.Column="1"
                        VerticalAlignment="Center" />

                    <CheckBox
                        x:Name="DomainCheckBox"
                        Grid.Row="5"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Content="Domain"
                        IsCheckedChanged="DomainCheckBox_IsCheckedChanged" />

                    <TextBox
                        x:Name="DomainTextBox"
                        Grid.Row="5"
                        Grid.Column="1"
                        MinWidth="240" />

                </Grid>
                </Border>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Editing">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Margin="{DynamicResource TwainContentPadding}"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Classes="twain-section-heading" Text="Edit summary settings" />

                    <CheckBox
                        x:Name="AddUsingAwbCheckBox"
                        Content="Add &quot;using Twain&quot; when deleting or protecting pages" />

                <CheckBox
                    x:Name="SuppressAwbCheckBox"
                    Grid.Row="6"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Content="Suppress &quot;using Twain&quot; in edit summary" />
                    </StackPanel>
                </Border>
                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                <TextBlock Classes="twain-section-heading" Text="Save settings" />
                    
                    <CheckBox
                        x:Name="SaveArticleListCheckBox"
                        Content="Save page list with settings" />

                    <CheckBox
                        x:Name="AutoSaveEditCheckBox"
                        Content="Automatically save edit box"
                        IsCheckedChanged="AutoSaveEditCheckBox_IsCheckedChanged" />

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Autosave file:" />

                        <Grid
                            Grid.Column="1"
                            ColumnDefinitions="*,Auto"
                            ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                            <TextBox
                                x:Name="AutoSaveFileTextBox"
                                Grid.Column="0"
                                MinWidth="260" />

                            <Button
                                x:Name="SetAutoSaveFileButton"
                                Classes="twain-command-button"
                                Grid.Column="1"
                                Content="Browse..."
                                Click="SetAutoSaveFileButton_Click" />

                        </Grid>
                    </Grid>

                        <Grid
                            ColumnDefinitions="Auto,Auto,*"
                            ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock
                                x:Name="AutoSavePeriodLabel"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="Autosave every:" />

                            <NumericUpDown
                                x:Name="AutoSavePeriodNumericUpDown"
                                Grid.Column="1"
                                Width="120"
                                Minimum="1"
                                Maximum="86400"
                                Value="60" />

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Text="seconds" />

                        </Grid>


                    <TextBlock Classes="twain-section-heading" Text="When ready to save:" />

                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{DynamicResource TwainSpacingLarge}">

                        <CheckBox
                            x:Name="FlashCheckBox"
                            Content="Flash" />

                        <CheckBox
                            x:Name="BeepCheckBox"
                            Content="Beep" />

                    </StackPanel>
                    </StackPanel>
                </Border>
                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
<StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock Classes="twain-section-heading" Text="Editor appearance" />

                    <Grid
                        ColumnDefinitions="Auto,*"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                        RowSpacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Font family:" />

                        <ComboBox
                            x:Name="EditorFontComboBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="200"
                            IsEditable="True">
                            <ComboBoxItem Content="Cascadia Mono" />
                            <ComboBoxItem Content="Cascadia Code" />
                            <ComboBoxItem Content="Consolas" />
                            <ComboBoxItem Content="Courier New" />
                            <ComboBoxItem Content="Arial" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Font size:" />

                        <NumericUpDown
                            x:Name="EditorFontSizeNumericUpDown"
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="120"
                            HorizontalAlignment="Left"
                            Minimum="8"
                            Maximum="36"
                            Increment="1"
                            Value="10" />

                    </Grid>

                    <CheckBox
                        x:Name="EditorWordWrapCheckBox"
                        Content="Enable word wrap" />

                    <CheckBox
                        x:Name="EditorLineNumbersCheckBox"
                        Content="Show line numbers" />

                    </StackPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Tools">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Margin="{DynamicResource TwainContentPadding}"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                <Border Classes="twain-section">
                    <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Classes="twain-section-heading" Text="Current article list" />

                    <TextBlock
                        Text="Choose how each tool handles the current article list."
                        TextWrapping="Wrap" />

                    <Grid
                        ColumnDefinitions="*,Auto"
                        RowDefinitions="Auto,Auto,Auto"
                        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                        RowSpacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="List Comparer:" />

                        <ComboBox
                            x:Name="ListComparerArticleListComboBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectedIndex="0">
    
                            <ComboBoxItem Content="Ask" />
                            <ComboBoxItem Content="Use current list" />
                            <ComboBoxItem Content="Do not use current list" />

                        </ComboBox>

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="List Splitter:" />

                        <ComboBox
                            x:Name="ListSplitterArticleListComboBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectedIndex="0">

                            <ComboBoxItem Content="Ask" />
                            <ComboBoxItem Content="Use current list" />
                            <ComboBoxItem Content="Do not use current list" />
                        </ComboBox>

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Text="Database Scanner:" />

                        <ComboBox
                            x:Name="DatabaseScannerArticleListComboBox"
                            Grid.Row="2"
                            Grid.Column="1"
                            MinWidth="180"
                            SelectedIndex="0">

                            <ComboBoxItem Content="Ask" />
                            <ComboBoxItem Content="Use current list" />
                            <ComboBoxItem Content="Do not use current list" />
                        </ComboBox>

                    </Grid>
                    </StackPanel>
                </Border>

                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Alerts">
                <Border Classes="twain-section" Margin="{DynamicResource TwainContentPadding}">
                <Grid
                    RowDefinitions="Auto,*"
                    RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock
                        Grid.Row="0"
                        Text="Select the alerts that should be enabled."
                        TextWrapping="Wrap" />

                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel
                            x:Name="AlertCheckBoxPanel"
                            Spacing="6" />

                    </ScrollViewer>

                </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <StackPanel
            Grid.Row="1"
            Margin="12,0,12,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

        <Button
            x:Name="OkButton"
            Classes="twain-primary-button"
            MinWidth="90"
            Content="OK"
            IsEnabled="True"
            IsDefault="True"
            Click="OkButton_Click" />

            <Button
                x:Name="CancelButton"
                Classes="twain-command-button"
                MinWidth="90"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</UserControl>