
<UserControl
    x:Class="Twain.UI.ReplaceSpecial.TemplateParamRuleControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        RowDefinitions="Auto,Auto,Auto,Auto"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Rule name -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Name:" />

        <TextBox
            x:Name="NameTextBox"
            Grid.Row="0"
            Grid.Column="1"
            TextChanged="NameTextBox_TextChanged" />

        <!-- Rule enabled -->
        <CheckBox
            x:Name="EnabledCheckBox"
            Grid.Row="1"
            Grid.Column="1"
            Content="Enabled" />

        <!-- Parameter name -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Parameter name:" />

        <TextBox
            x:Name="ParamNameTextBox"
            Grid.Row="2"
            Grid.Column="1" />

        <!-- Replacement parameter name -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Change name to:" />

        <TextBox
            x:Name="ChangeNameToTextBox"
            Grid.Row="3"
            Grid.Column="1" />

    </Grid>

</UserControl>
