
<UserControl
    x:Class="Twain.UI.ReplaceSpecial.InTemplateRuleControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Rule name -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Name:" />

        <TextBox
            x:Name="NameTextBox"
            Grid.Row="0"
            Grid.Column="1"
            DoubleTapped="NameTextBox_DoubleTapped"
            TextChanged="NameTextBox_TextChanged" />

        <!-- Rule enabled -->
        <CheckBox
            x:Name="EnabledCheckBox"
            Grid.Row="1"
            Grid.Column="1"
            Content="Enabled" />

        <!-- Template alias entry -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Template:" />

        <Grid
            Grid.Row="2"
            Grid.Column="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="{DynamicResource TwainSpacingSmall}">

            <TextBox
                x:Name="AliasTextBox"
                Grid.Column="0" />

            <Button
                Grid.Column="1"
                Classes="twain-command-button"
                Content="Add"
                Click="AddButton_Click" />

        </Grid>

        <!-- Template aliases -->
        <Grid
            Grid.Row="3"
            Grid.Column="1"
            RowDefinitions="*,Auto"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <ListBox
                x:Name="AliasesListBox"
                Classes="twain-listbox"
                Grid.Row="0"
                MinHeight="80"
                SelectionChanged="AliasesListBox_SelectionChanged" />

            <Button
                x:Name="DeleteButton"
                Grid.Row="1"
                Classes="twain-command-button"
                HorizontalAlignment="Right"
                Content="Delete"
                Click="DeleteButton_Click" />

        </Grid>

        <!-- Replacement settings -->
        <CheckBox
            x:Name="ReplaceCheckBox"
            Grid.Row="4"
            Grid.Column="1"
            Content="Replace template"
            IsCheckedChanged="ReplaceCheckBox_Changed" />

        <Grid
            Grid.Row="5"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource TwainSpacingMedium}">

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Replace with:" />

            <TextBox
                x:Name="ReplaceWithTextBox"
                Grid.Column="1" />

        </Grid>

    </Grid>

</UserControl>
