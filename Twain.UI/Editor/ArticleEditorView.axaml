
<UserControl
    x:Class="Twain.UI.Editor.ArticleEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.Editor"
    xmlns:editorControls="using:Twain.UI.Editor"
    x:DataType="vm:ArticleEditorViewModel"
    d:DesignWidth="700"
    d:DesignHeight="450"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ArticleEditorViewModel />
    </Design.DataContext>

    <Grid
        RowDefinitions="Auto,Auto,*"
        RowSpacing="{DynamicResource TwainSpacingSmall}">

        <!-- Optional Edit Bar -->
        <editorControls:EditToolbarView
            x:Name="EditToolbar"
            Grid.Row="0"
            IsVisible="True" />

        <!-- Calculated edit summary -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource TwainSpacingSmall}"
            Margin="4,4,4,0">

            <TextBlock
                Grid.Column="0"
                Text="Edit summary:"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TwainTextPrimaryBrush}" />

            <TextBox
                Grid.Column="1"
                Text="{Binding CalculatedEditSummary, Mode=TwoWay}"
                PlaceholderText="Calculated edit summary"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch" />

        </Grid>

        <!-- Monaco article editor -->
        <NativeWebView
            x:Name="EditorWebView"
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    </Grid>

</UserControl>
