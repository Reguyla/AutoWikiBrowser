<UserControl
    x:Class="Twain.UI.Editor.ArticleEditorView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.Editor"
    x:DataType="vm:ArticleEditorViewModel"
    d:DesignWidth="700"
    d:DesignHeight="450"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ArticleEditorViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            Margin="0,0,0,8"
            ColumnDefinitions="Auto,*">

            <TextBlock
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Text="Edit summary:" />

            <TextBox
                Grid.Column="1"
                Text="{Binding EditSummary, Mode=TwoWay}"
                Watermark="Describe your changes" />

        </Grid>

        <NativeWebView
            x:Name="EditorWebView"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch" />

    </Grid>

</UserControl>