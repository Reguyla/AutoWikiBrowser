
<Window
    x:Class="Twain.UI.Disambiguation.DabWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disambiguation"
    Width="760"
    Height="560"
    MinWidth="600"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Header -->
        <StackPanel
            Grid.Row="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Classes="twain-section-heading"
                Text="Disambiguation" />

            <TextBlock
                Text="Review and select the appropriate links for this page."
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                TextWrapping="Wrap" />

        </StackPanel>

        <!-- Disambiguation items -->
        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="{DynamicResource TwainBorderThickness}"
            CornerRadius="{DynamicResource TwainControlCornerRadius}"
            Background="{DynamicResource TwainControlBackgroundBrush}">

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    x:Name="DisambiguationItemsPanel"
                    Margin="12"
                    Spacing="{DynamicResource TwainSpacingMedium}" />

            </ScrollViewer>

        </Border>

        <!-- Commands -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto">

            <!-- Page and reset commands -->
            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-command-button"
                    Content="_Page…"
                    Click="PageButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="_Undo all"
                    Click="UndoAllButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="_Reset all"
                    Click="ResetAllButton_Click" />

            </StackPanel>

            <!-- Completion commands -->
            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-command-button"
                    Content="_Abort"
                    Click="AbortButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />

                <Button
                    x:Name="DoneButton"
                    Classes="twain-primary-button"
                    Content="Done"
                    IsDefault="True"
                    Click="DoneButton_Click" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>
