<Window
    x:Class="Twain.UI.Disambiguation.DabWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Disambiguation"
    Width="760"
    Height="560"
    MinWidth="600"
    MinHeight="400"
    WindowStartupLocation="CenterOwner">

    <Grid
        Margin="20"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="16">

        <StackPanel
            Grid.Row="0"
            Spacing="4">

            <TextBlock
                Text="Disambiguation"
                FontSize="20"
                FontWeight="SemiBold" />

            <TextBlock
                Text="Review and select the appropriate links for this page."
                Opacity="0.7"
                TextWrapping="Wrap" />

        </StackPanel>

        <Border
            Grid.Row="1"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="1"
            CornerRadius="6">

            <ScrollViewer
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">

                <StackPanel
                    x:Name="DisambiguationItemsPanel"
                    Margin="12"
                    Spacing="8" />

            </ScrollViewer>

        </Border>

        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto">

            <StackPanel
                Grid.Column="0"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="_Page…"
                    Click="PageButton_Click" />

                <Button
                    Content="_Undo all"
                    Click="UndoAllButton_Click" />

                <Button
                    Content="_Reset all"
                    Click="ResetAllButton_Click" />

            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="8">

                <Button
                    Content="_Abort"
                    Click="AbortButton_Click" />

                <Button
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />

                <Button
                    x:Name="DoneButton"
                    Content="Done"
                    IsDefault="True"
                    Click="DoneButton_Click" />

            </StackPanel>

        </Grid>

    </Grid>

</Window>