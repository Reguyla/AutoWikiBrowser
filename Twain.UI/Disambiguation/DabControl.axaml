
<UserControl
    x:Class="Twain.UI.Disambiguation.DabControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="600">

    <Border
        Classes="twain-section"
        Margin="4">

        <Grid
            RowDefinitions="Auto,Auto,Auto"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <!-- Paragraph context -->
            <TextBlock
                x:Name="ParagraphTextBlock"
                Grid.Row="0"
                TextWrapping="Wrap" />

            <!-- Disambiguation choice -->
            <ComboBox
                x:Name="ChoiceComboBox"
                Grid.Row="1"
                SelectionChanged="ChoiceComboBox_SelectionChanged" />

            <!-- Correction and editing commands -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="*,Auto,Auto"
                ColumnSpacing="{DynamicResource TwainSpacingSmall}">

                <TextBox
                    x:Name="CorrectionTextBox"
                    Grid.Column="0"
                    TextChanged="CorrectionTextBox_TextChanged" />

                <Button
                    x:Name="UnpipeButton"
                    Grid.Column="1"
                    Classes="twain-command-button"
                    Content="Unpipe"
                    Click="UnpipeButton_Click" />

                <Button
                    x:Name="FlipButton"
                    Grid.Column="2"
                    Classes="twain-command-button"
                    Content="Flip"
                    Click="FlipButton_Click" />

            </Grid>
        </Grid>
    </Border>
</UserControl>
