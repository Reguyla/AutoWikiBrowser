<UserControl
    x:Class="Twain.UI.Disambiguation.DabControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="600">

    <Border
        Margin="4"
        Padding="8"
        BorderThickness="1"
        CornerRadius="4">

        <Grid RowDefinitions="Auto,Auto,Auto"
              RowSpacing="6">

            <TextBlock
                x:Name="ParagraphTextBlock"
                Grid.Row="0"
                TextWrapping="Wrap" />

            <ComboBox
                x:Name="ChoiceComboBox"
                Grid.Row="1"
                SelectionChanged="ChoiceComboBox_SelectionChanged" />

<Grid
    Grid.Row="2"
    ColumnDefinitions="*,Auto,Auto"
    ColumnSpacing="6">

    <TextBox
        x:Name="CorrectionTextBox"
        Grid.Column="0"
        TextChanged="CorrectionTextBox_TextChanged" />

    <Button
        x:Name="UnpipeButton"
        Grid.Column="1"
        Content="Unpipe"
        Click="UnpipeButton_Click" />

    <Button
        x:Name="FlipButton"
        Grid.Column="2"
        Content="Flip"
        Click="FlipButton_Click" />

</Grid>

        </Grid>
    </Border>
</UserControl>