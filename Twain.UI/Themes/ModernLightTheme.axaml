
<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
    Twain Modern Light Theme

    A contemporary, IDE-inspired editing workspace.

    Design principles:
    - Cool, neutral application backgrounds
    - Clean white editing surfaces
    - Soft blue panel headers
    - Distinct blue interactive accents
    - Subtle borders and rounded corners
    - Comfortable spacing and readable typography

    All existing Twain resource keys are preserved.
    -->

    <!-- ========================================= -->
    <!-- APPLICATION BACKGROUNDS                   -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorApplicationBackground">#FFF3F7FC</Color>

    <Color x:Key="TwainColorWorkspaceBackground">#FFEAF1F9</Color>

    <Color x:Key="TwainColorSurface">#FFFFFFFF</Color>

    <Color x:Key="TwainColorRaisedSurface">#FFFFFFFF</Color>

    <!-- ========================================= -->
    <!-- CONTROL BACKGROUNDS                       -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorControlBackground">#FFFFFFFF</Color>

    <Color x:Key="TwainColorControlBackgroundDisabled">#FFE8EDF4</Color>

    <!-- ========================================= -->
    <!-- BORDERS                                   -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorBorder">#FFB8CBE0</Color>

    <Color x:Key="TwainColorBorderSubtle">#FFD2DEEC</Color>

    <!-- ========================================= -->
    <!-- TEXT                                      -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorTextPrimary">#FF23364D</Color>

    <Color x:Key="TwainColorTextSecondary">#FF60748D</Color>

    <Color x:Key="TwainColorTextDisabled">#FF8C9BAD</Color>

    <!-- ========================================= -->
    <!-- INTERACTIVE ACCENTS                       -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorAccent">#FF1674D8</Color>

    <Color x:Key="TwainColorAccentHover">#FF1265BE</Color>

    <Color x:Key="TwainColorAccentPressed">#FF0D529D</Color>

    <Color x:Key="TwainColorSelection">#FFDCEBFC</Color>

    <Color x:Key="TwainColorFocus">#FF1674D8</Color>

    <!-- ========================================= -->
    <!-- APPLICATION CHROME                        -->
    <!-- ========================================= -->

    <Color x:Key="TwainColorPaneHeader">#FFE8F1FC</Color>

    <Color x:Key="TwainColorToolbar">#FFF8FAFD</Color>

    <Color x:Key="TwainColorStatusBar">#FFF3F7FC</Color>

    <!-- ========================================= -->
    <!-- STATUS COLORS                             -->
    <!-- ========================================= -->

    <!-- Information: blue -->
    <Color x:Key="TwainColorInformation">#FF1674D8</Color>

    <!-- Success: teal -->
    <Color x:Key="TwainColorSuccess">#FF087F78</Color>

    <!-- Warning: amber -->
    <Color x:Key="TwainColorWarning">#FFB77908</Color>

    <!-- Error: crimson -->
    <Color x:Key="TwainColorError">#FFC53C50</Color>

    <!-- ========================================= -->
    <!-- APPLICATION BRUSHES                       -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainApplicationBackgroundBrush"
        Color="{DynamicResource TwainColorApplicationBackground}" />

    <SolidColorBrush
        x:Key="TwainWorkspaceBackgroundBrush"
        Color="{DynamicResource TwainColorWorkspaceBackground}" />

    <SolidColorBrush
        x:Key="TwainSurfaceBrush"
        Color="{DynamicResource TwainColorSurface}" />

    <SolidColorBrush
        x:Key="TwainRaisedSurfaceBrush"
        Color="{DynamicResource TwainColorRaisedSurface}" />

    <!-- ========================================= -->
    <!-- CONTROL BRUSHES                           -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainControlBackgroundBrush"
        Color="{DynamicResource TwainColorControlBackground}" />

    <SolidColorBrush
        x:Key="TwainControlBackgroundDisabledBrush"
        Color="{DynamicResource TwainColorControlBackgroundDisabled}" />

    <!-- ========================================= -->
    <!-- BORDER BRUSHES                            -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainBorderBrush"
        Color="{DynamicResource TwainColorBorder}" />

    <SolidColorBrush
        x:Key="TwainBorderSubtleBrush"
        Color="{DynamicResource TwainColorBorderSubtle}" />

    <!-- ========================================= -->
    <!-- TEXT BRUSHES                              -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainTextPrimaryBrush"
        Color="{DynamicResource TwainColorTextPrimary}" />

    <SolidColorBrush
        x:Key="TwainTextSecondaryBrush"
        Color="{DynamicResource TwainColorTextSecondary}" />

    <SolidColorBrush
        x:Key="TwainTextDisabledBrush"
        Color="{DynamicResource TwainColorTextDisabled}" />

    <!-- ========================================= -->
    <!-- INTERACTIVE BRUSHES                       -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainAccentBrush"
        Color="{DynamicResource TwainColorAccent}" />

    <SolidColorBrush
        x:Key="TwainAccentHoverBrush"
        Color="{DynamicResource TwainColorAccentHover}" />

    <SolidColorBrush
        x:Key="TwainAccentPressedBrush"
        Color="{DynamicResource TwainColorAccentPressed}" />

    <SolidColorBrush
        x:Key="TwainSelectionBrush"
        Color="{DynamicResource TwainColorSelection}" />

    <SolidColorBrush
        x:Key="TwainFocusBrush"
        Color="{DynamicResource TwainColorFocus}" />

    <!-- ========================================= -->
    <!-- STATUS BRUSHES                            -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainInformationBrush"
        Color="{DynamicResource TwainColorInformation}" />

    <SolidColorBrush
        x:Key="TwainSuccessBrush"
        Color="{DynamicResource TwainColorSuccess}" />

    <SolidColorBrush
        x:Key="TwainWarningBrush"
        Color="{DynamicResource TwainColorWarning}" />

    <SolidColorBrush
        x:Key="TwainErrorBrush"
        Color="{DynamicResource TwainColorError}" />

    <!-- ========================================= -->
    <!-- APPLICATION CHROME BRUSHES                -->
    <!-- ========================================= -->

    <SolidColorBrush
        x:Key="TwainPaneHeaderBrush"
        Color="{DynamicResource TwainColorPaneHeader}" />

    <SolidColorBrush
        x:Key="TwainToolbarBrush"
        Color="{DynamicResource TwainColorToolbar}" />

    <SolidColorBrush
        x:Key="TwainStatusBarBrush"
        Color="{DynamicResource TwainColorStatusBar}" />

    <!-- ========================================= -->
    <!-- SPACING                                   -->
    <!-- ========================================= -->

    <x:Double x:Key="TwainSpacingExtraSmall">3</x:Double>

    <x:Double x:Key="TwainSpacingSmall">6</x:Double>

    <x:Double x:Key="TwainSpacingMedium">10</x:Double>

    <x:Double x:Key="TwainSpacingLarge">14</x:Double>

    <x:Double x:Key="TwainSpacingExtraLarge">20</x:Double>

    <!-- ========================================= -->
    <!-- CONTROL DIMENSIONS                        -->
    <!-- ========================================= -->

    <x:Double x:Key="TwainControlHeight">32</x:Double>

    <x:Double x:Key="TwainCompactControlHeight">28</x:Double>

    <x:Double x:Key="TwainPaneHeaderHeight">34</x:Double>

    <!-- ========================================= -->
    <!-- TYPOGRAPHY                                -->
    <!-- ========================================= -->

    <x:Double x:Key="TwainFontSizeSmall">11</x:Double>

    <x:Double x:Key="TwainFontSizeNormal">12</x:Double>

    <x:Double x:Key="TwainFontSizeMedium">14</x:Double>

    <x:Double x:Key="TwainFontSizeLarge">18</x:Double>

    <x:Double x:Key="TwainFontSizeTitle">24</x:Double>

    <!-- ========================================= -->
    <!-- CORNER RADII                              -->
    <!-- ========================================= -->

    <CornerRadius x:Key="TwainControlCornerRadius">6</CornerRadius>

    <CornerRadius x:Key="TwainPaneCornerRadius">8</CornerRadius>

    <!-- ========================================= -->
    <!-- THICKNESS AND PADDING                     -->
    <!-- ========================================= -->

    <Thickness x:Key="TwainBorderThickness">1</Thickness>

    <Thickness x:Key="TwainControlPadding">12,6</Thickness>

    <Thickness x:Key="TwainPanePadding">12</Thickness>

    <Thickness x:Key="TwainContentPadding">20</Thickness>

    <Thickness x:Key="TwainWorkspacePadding">12</Thickness>

</ResourceDictionary>
