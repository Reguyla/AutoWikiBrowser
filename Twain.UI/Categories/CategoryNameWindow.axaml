
<Window
    x:Class="Twain.UI.Categories.CategoryNameWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Category"
    Width="460"
    MinHeight="180"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Dialog heading -->
        <StackPanel
            Grid.Row="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Text="Category"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}" />

            <TextBlock
                Text="Enter the name of the category."
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                TextWrapping="Wrap" />

        </StackPanel>

        <!-- Category entry -->
        <Border
            Grid.Row="1"
            Padding="12"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <Grid
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <!-- Category namespace -->
                <TextBlock
                    x:Name="CategoryNamespaceTextBlock"
                    Grid.Column="0"
                    VerticalAlignment="Center" />

                <!-- Category name -->
                <TextBox
                    x:Name="CategoryNameTextBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Center" />

            </Grid>
        </Border>

        <!-- Dialog commands -->
        <Border
            Grid.Row="2"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <Button
                Classes="twain-primary-button"
                HorizontalAlignment="Right"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

        </Border>

    </Grid>
</Window>
