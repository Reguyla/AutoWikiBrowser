<Window
    x:Class="Twain.UI.Categories.CategoryNameWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Category"
    Width="460"
    Height="150"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16"
          RowDefinitions="Auto,Auto"
          ColumnDefinitions="Auto,*"
          RowSpacing="16"
          ColumnSpacing="4">

        <TextBlock x:Name="CategoryNamespaceTextBlock"
                   Grid.Row="0"
                   Grid.Column="0"
                   VerticalAlignment="Center" />

        <TextBox x:Name="CategoryNameTextBox"
                 Grid.Row="0"
                 Grid.Column="1"
                 VerticalAlignment="Center" />

        <Button Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                HorizontalAlignment="Right"
                MinWidth="80"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />
    </Grid>
</Window>