
<Window
    x:Class="Twain.UI.Background.PleaseWaitWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460"
    MinHeight="180"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Please wait"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Status heading and message -->
        <StackPanel
            Grid.Row="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Text="Please wait"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}" />

            <TextBlock
                x:Name="StatusTextBlock"
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                TextWrapping="Wrap"
                MinHeight="24" />

        </StackPanel>

        <!-- Progress section -->
        <Border
            x:Name="ProgressGroupBox"
            Grid.Row="1"
            Padding="12"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <StackPanel
                Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                x:Name="ProgressHeaderTextBlock"
                Text="Progress"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}" />

                <ProgressBar
                    x:Name="ProgressBar"
                    Minimum="0"
                    Maximum="1"
                    Value="0"
                    Height="12"
                    HorizontalAlignment="Stretch" />

            </StackPanel>

        </Border>

        <!-- Dialog commands -->
        <Border
            Grid.Row="2"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <Button
                Classes="twain-command-button"
                Content="_Cancel"
                HorizontalAlignment="Right"
                IsCancel="True"
                Click="CancelButton_Click" />

        </Border>

    </Grid>
</Window>
