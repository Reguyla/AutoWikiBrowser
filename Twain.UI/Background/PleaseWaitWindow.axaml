
<Window
    x:Class="Twain.UI.Background.PleaseWaitWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="460"
    Height="190"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Please wait"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Status message -->
        <TextBlock
            x:Name="StatusTextBlock"
            Grid.Row="0"
            TextWrapping="Wrap" />

        <!-- Progress indicator -->
        <GroupBox
            x:Name="ProgressGroupBox"
            Grid.Row="1"
            Header="Progress">

            <ProgressBar
                x:Name="ProgressBar"
                Minimum="0"
                Maximum="1"
                Value="0"
                Height="18"
                Margin="8" />
        </GroupBox>

        <!-- Commands -->
        <Button
            Grid.Row="2"
            Classes="twain-command-button"
            Content="_Cancel"
            HorizontalAlignment="Right"
            IsCancel="True"
            Click="CancelButton_Click" />

    </Grid>
</Window>
