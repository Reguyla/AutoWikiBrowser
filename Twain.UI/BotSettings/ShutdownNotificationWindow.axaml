<Window
    x:Class="Twain.UI.BotSettings.ShutdownNotificationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="180"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Processing complete">

    <Grid
        Margin="20"
        RowDefinitions="*,Auto">

        <TextBlock
            x:Name="MessageTextBlock"
            VerticalAlignment="Center"
            FontSize="15"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="1"
            Margin="0,20,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                Width="90"
                Click="CancelButton_Click"
                Content="Cancel" />

            <Button
                Width="90"
                Click="ContinueButton_Click"
                Content="Continue" />

        </StackPanel>
    </Grid>
</Window>