
<Window
    x:Class="Twain.UI.BotSettings.ShutdownNotificationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="180"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Processing complete"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Notification message -->
        <TextBlock
            x:Name="MessageTextBlock"
            Grid.Row="0"
            VerticalAlignment="Center"
            FontSize="15"
            TextWrapping="Wrap" />

        <!-- Commands -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                Classes="twain-command-button"
                Click="CancelButton_Click"
                Content="Cancel" />

            <Button
                Classes="twain-primary-button"
                Click="ContinueButton_Click"
                Content="Continue" />

        </StackPanel>
    </Grid>
</Window>
