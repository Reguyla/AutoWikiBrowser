
<Window
    x:Class="Twain.UI.BotSettings.ShutdownNotificationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    MinHeight="180"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Processing complete"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Notification content -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <StackPanel
                Spacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Text="Processing complete"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TwainTextPrimaryBrush}" />

                <TextBlock
                    x:Name="MessageTextBlock"
                    FontSize="14"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    TextWrapping="Wrap" />

            </StackPanel>
        </Border>

        <!-- Dialog commands -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingMedium}">

                <Button
                    Classes="twain-command-button"
                    Click="CancelButton_Click"
                    Content="Cancel" />

                <Button
                    Classes="twain-primary-button"
                    Click="ContinueButton_Click"
                    Content="Continue" />

            </StackPanel>
        </Border>

    </Grid>
</Window>
