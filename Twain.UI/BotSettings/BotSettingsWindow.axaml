
<UserControl
    x:Class="Twain.UI.BotSettings.BotSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.BotSettings"
    x:DataType="vm:BotSettingsViewModel"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:BotSettingsViewModel />
    </Design.DataContext>

    <Grid
        Background="{DynamicResource TwainApplicationBackgroundBrush}"
        RowDefinitions="*,Auto">

        <Grid
            Margin="{DynamicResource TwainContentPadding}"
            RowDefinitions="*,Auto"
            RowSpacing="{DynamicResource TwainSpacingLarge}">

            <ScrollViewer>
                <StackPanel Spacing="{DynamicResource TwainSpacingLarge}">

                    <!-- Automatic saving -->
                    <Border Classes="twain-section">
                        <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock
                                Classes="twain-section-heading"
                                Text="Automatic saving" />

                            <CheckBox
                                Content="Auto save"
                                IsChecked="{Binding AutoSaveEnabled}"
                                IsEnabled="{Binding CanUseBotMode}" />

                            <Grid
                                ColumnDefinitions="Auto,120,*"
                                ColumnSpacing="{DynamicResource TwainSpacingSmall}"
                                IsEnabled="{Binding AutoSaveEnabled}">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Delay" />

                                <NumericUpDown
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding AutoSaveDelay}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="seconds between edits" />
                            </Grid>

                            <Grid
                                ColumnDefinitions="Auto,120,*"
                                ColumnSpacing="{DynamicResource TwainSpacingSmall}"
                                IsEnabled="{Binding AutoSaveEnabled}">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="Maximum edits" />

                                <NumericUpDown
                                    Grid.Column="1"
                                    Minimum="0"
                                    Value="{Binding MaximumEdits}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Text="0 = no limit" />
                            </Grid>

                            <CheckBox
                                Content="Suppress &quot;using Twain&quot; in edit summary"
                                IsChecked="{Binding SuppressUsingTwain}" />
                        </StackPanel>
                    </Border>

                    <!-- Nudge behavior -->
                    <Border Classes="twain-section">
                        <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock
                                Classes="twain-section-heading"
                                Text="Nudge timer" />

                            <CheckBox
                                Content="Resave if processing becomes stuck"
                                IsChecked="{Binding NudgeEnabled}" />

                            <CheckBox
                                Margin="20,0,0,0"
                                Content="Skip page after repeated nudge failures"
                                IsChecked="{Binding SkipAfterRepeatedNudge}"
                                IsEnabled="{Binding NudgeEnabled}" />

                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{DynamicResource TwainSpacingMedium}">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{Binding NudgeCount, StringFormat='Total nudges: {0}'}" />

                                <Button
                                    Classes="twain-command-button"
                                    Command="{Binding ResetNudgeCountCommand}"
                                    Content="Reset counter"
                                    IsEnabled="{Binding AutoSaveEnabled}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Completion action -->
                    <Border Classes="twain-section">
                        <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock
                                Classes="twain-section-heading"
                                Text="After processing" />

                            <CheckBox
                                Content="Perform a system action when processing completes"
                                IsChecked="{Binding AutomaticShutdownEnabled}" />

                            <StackPanel
                                Margin="20,0,0,0"
                                IsEnabled="{Binding AutomaticShutdownEnabled}"
                                Spacing="{DynamicResource TwainSpacingSmall}">

                                <RadioButton
                                    x:Name="ShutdownRadioButton"
                                    Click="ShutdownRadioButton_Click"
                                    Content="Shutdown"
                                    GroupName="ShutdownAction" />

                                <RadioButton
                                    x:Name="StandbyRadioButton"
                                    Click="StandbyRadioButton_Click"
                                    Content="Standby"
                                    GroupName="ShutdownAction" />

                                <RadioButton
                                    x:Name="RestartRadioButton"
                                    Click="RestartRadioButton_Click"
                                    Content="Restart"
                                    GroupName="ShutdownAction" />

                                <RadioButton
                                    x:Name="HibernateRadioButton"
                                    Click="HibernateRadioButton_Click"
                                    Content="Hibernate"
                                    GroupName="ShutdownAction" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Commands -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{DynamicResource TwainSpacingMedium}">

                <Button
                    Classes="twain-command-button"
                    Click="CancelButton_Click"
                    Content="Cancel" />

                <Button
                    Classes="twain-primary-button"
                    Click="OkButton_Click"
                    Content="OK" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
