<UserControl
    x:Class="Twain.UI.Views.Workspaces.WorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    xmlns:workspaceControls="using:Twain.UI.Controls.Workspaces"
    x:DataType="vm:WorkspaceViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:WorkspaceViewModel />
    </Design.DataContext>

 <UserControl.Resources>

    <!--
    Hosts each workspace pane through the shared pane presentation control.
    -->
    <DataTemplate
        x:Key="WorkspacePaneTemplate"
        x:DataType="vm:PaneViewModel">

        <workspaceControls:WorkspacePaneHost />

    </DataTemplate>

</UserControl.Resources>

    <Grid
        Margin="{DynamicResource TwainWorkspacePadding}"
        Background="{DynamicResource TwainWorkspaceBackgroundBrush}"
        RowDefinitions="Auto,*">

        <!-- Workspace heading and temporary pane-restoration command. -->

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource TwainFontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                Text="Workspace" />

            <Button
                MinHeight="{DynamicResource TwainControlHeight}"
                Padding="{DynamicResource TwainControlPadding}"
                Command="{Binding ShowAllPanesCommand}"
                Content="Show all panes" />

        </StackPanel>

        <!--
        Initial built-in editing workspace.

        The layout is intentionally fixed for now. Future changes will
        allow the user to move, resize, dock, float, hide, and restore panes.
        -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="260,8,300,8,*"
            RowDefinitions="*,8,260">

            <!-- Left region: article navigation and queue-related panes. -->

            <ItemsControl
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding LeftPanes}" />

            <GridSplitter
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <!-- Center region: options and job-configuration panes. -->

            <ItemsControl
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="2"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding CenterPanes}" />

            <GridSplitter
                Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <!-- Upper-right document region: primary article editor. -->

            <ItemsControl
                Grid.Row="0"
                Grid.Column="4"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding DocumentPanes}" />

            <GridSplitter
                Grid.Row="1"
                Grid.Column="4"
                Height="8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext" />

            <!-- Lower-right results region: diff and preview tools. -->

            <ItemsControl
                Grid.Row="2"
                Grid.Column="4"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding BottomPanes}" />

        </Grid>

    </Grid>

</UserControl>