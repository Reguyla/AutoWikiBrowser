<UserControl
    x:Class="Twain.UI.Views.Workspaces.WorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    x:DataType="vm:WorkspaceViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:WorkspaceViewModel />
    </Design.DataContext>

    <Grid
        Margin="{DynamicResource TwainWorkspacePadding}"
        Background="{DynamicResource TwainWorkspaceBackgroundBrush}"
        RowDefinitions="Auto,*">

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource TwainFontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                Text="Workspace" />

            <Button
                MinHeight="{DynamicResource TwainControlHeight}"
                Padding="{DynamicResource TwainControlPadding}"
                Command="{Binding ShowAllPanesCommand}"
                Content="Show all panes" />

        </StackPanel>

        <ItemsControl
            Grid.Row="1"
            ItemsSource="{Binding Panes}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel
                        HorizontalAlignment="Stretch"
                        Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PaneViewModel">

                    <Border
                        Width="320"
                        MinHeight="220"
                        Margin="6"
                        Padding="{DynamicResource TwainPanePadding}"
                        Background="{DynamicResource TwainSurfaceBrush}"
                        BorderBrush="{DynamicResource TwainBorderBrush}"
                        BorderThickness="{DynamicResource TwainBorderThickness}"
                        CornerRadius="{DynamicResource TwainPaneCornerRadius}"
                        IsVisible="{Binding IsVisible}">

                        <Grid RowDefinitions="Auto,*">

                            <Grid
                                Grid.Row="0"
                                ColumnDefinitions="*,Auto"
                                Margin="0,0,0,12">

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="{DynamicResource TwainFontSizeMedium}"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TwainTextPrimaryBrush}"
                                    Text="{Binding Title}" />

                                <Button
                                    Grid.Column="1"
                                    MinHeight="{DynamicResource TwainCompactControlHeight}"
                                    Padding="{DynamicResource TwainControlPadding}"
                                    Command="{Binding
                                        $parent[ItemsControl].((vm:WorkspaceViewModel)DataContext).HidePaneCommand}"
                                    CommandParameter="{Binding}"
                                    Content="Close" />

                            </Grid>

                            <Border
                                Grid.Row="1"
                                Padding="{DynamicResource TwainContentPadding}"
                                Background="{DynamicResource TwainRaisedSurfaceBrush}"
                                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                                BorderThickness="{DynamicResource TwainBorderThickness}"
                                CornerRadius="{DynamicResource TwainControlCornerRadius}">

                                <StackPanel
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="{DynamicResource TwainSpacingMedium}">

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="{DynamicResource TwainFontSizeLarge}"
                                        Foreground="{DynamicResource TwainTextPrimaryBrush}"
                                        Text="{Binding Title}" />

                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource TwainTextSecondaryBrush}"
                                        Text="Placeholder pane" />

                                </StackPanel>

                            </Border>

                        </Grid>

                    </Border>

                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Grid>

</UserControl>