<Window
    x:Class="Twain.UI.Profiles.ProfilesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profiles="clr-namespace:Twain.UI.Profiles"
    Title="Profiles"
    Width="720"
    Height="480"
    MinWidth="600"
    MinHeight="400"
    WindowStartupLocation="CenterOwner">

    <Grid Margin="16"
          RowDefinitions="*,Auto"
          RowSpacing="12">

            <DataGrid x:Name="ProfilesDataGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      SelectionChanged="ProfilesDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="Username"
                    Binding="{Binding Username, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Password saved?"
                    Binding="{Binding PasswordSaved, x:DataType=profiles:ProfileListItem}"
                    Width="*" />

                <DataGridTextColumn
                    Header="Default settings"
                    Binding="{Binding DefaultSettings, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Notes"
                    Binding="{Binding Notes, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />
            </DataGrid.Columns>

        </DataGrid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">

            <Button x:Name="AddButton"
                    Content="Add"
                    MinWidth="80"
                    Click="AddButton_Click" />

            <Button x:Name="EditButton"
                    Content="Edit"
                    MinWidth="80"
                    IsEnabled="False"
                    Click="EditButton_Click" />

            <Button x:Name="DeleteButton"
                    Content="Delete"
                    MinWidth="80"
                    IsEnabled="False"
                    Click="DeleteButton_Click" />

            <Button x:Name="LoginButton"
                    Content="Login"
                    MinWidth="80"
                    IsEnabled="False"
                    Click="LoginButton_Click" />

            <Button Content="Close"
                    MinWidth="80"
                    Click="CloseButton_Click" />

        </StackPanel>

    </Grid>
</Window>