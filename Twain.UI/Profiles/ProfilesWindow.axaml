
<UserControl
    x:Class="Twain.UI.Profiles.ProfilesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profiles="clr-namespace:Twain.UI.Profiles"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Saved profiles -->
        <Border
            Grid.Row="0"
            Classes="twain-section"
            Margin="0"
            MinHeight="0">

            <Grid
                RowDefinitions="Auto,*,Auto"
                RowSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Row="0"
                    Classes="twain-section-heading"
                    Text="Saved profiles" />

                <DataGrid
                    x:Name="ProfilesDataGrid"
                    Classes="twain-datagrid"
                    Grid.Row="1"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    GridLinesVisibility="Horizontal"
                    SelectionChanged="ProfilesDataGrid_SelectionChanged">

                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Header="ID"
                            Binding="{Binding ID, x:DataType=profiles:ProfileListItem}"
                            Width="Auto" />

                        <DataGridTextColumn
                            Header="Username"
                            Binding="{Binding Username, x:DataType=profiles:ProfileListItem}"
                            Width="2*" />

                        <DataGridTextColumn
                            Header="Password saved?"
                            Binding="{Binding PasswordSaved, x:DataType=profiles:ProfileListItem}"
                            Width="*" />

                        <DataGridTextColumn
                            Header="Default settings"
                            Binding="{Binding DefaultSettings, x:DataType=profiles:ProfileListItem}"
                            Width="2*" />

                        <DataGridTextColumn
                            Header="Notes"
                            Binding="{Binding Notes, x:DataType=profiles:ProfileListItem}"
                            Width="2*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Saved profile actions -->
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource TwainSpacingSmall}">

                    <Button
                        x:Name="LoginButton"
                        Classes="twain-primary-button"
                        Content="Login"
                        IsEnabled="False"
                        Click="LoginButton_Click" />

                    <Button
                        x:Name="AddButton"
                        Classes="twain-command-button"
                        Content="Add..."
                        Click="AddButton_Click" />

                    <Button
                        x:Name="EditButton"
                        Classes="twain-command-button"
                        Content="Edit..."
                        IsEnabled="False"
                        Click="EditButton_Click" />

                    <Button
                        x:Name="DeleteButton"
                        Classes="twain-command-button"
                        Content="Delete"
                        IsEnabled="False"
                        Click="DeleteButton_Click" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- Quick login -->
        <Border
            Grid.Row="1"
            Classes="twain-section"
            Margin="0">

            <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Classes="twain-section-heading"
                    Text="Quick login" />

                <Grid
                    ColumnDefinitions="Auto,*,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock
                        Grid.Row="0"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Username:" />

                    <TextBox
                        x:Name="QuickLoginUsernameTextBox"
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        TextChanged="QuickLoginCredentials_TextChanged" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="Password:" />

                    <TextBox
                        x:Name="QuickLoginPasswordTextBox"
                        Grid.Row="1"
                        Grid.Column="1"
                        PasswordChar="●"
                        TextChanged="QuickLoginCredentials_TextChanged" />

                    <Button
                        x:Name="QuickLoginButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Classes="twain-primary-button"
                        Content="Login"
                        IsEnabled="False"
                        Click="QuickLoginButton_Click" />

                    <CheckBox
                        x:Name="SaveQuickLoginProfileCheckBox"
                        Grid.Row="2"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        Content="Save this account"
                        IsCheckedChanged="SaveQuickLoginProfileCheckBox_IsCheckedChanged" />

                    <CheckBox
                        x:Name="SaveQuickLoginPasswordCheckBox"
                        Grid.Row="2"
                        Grid.Column="2"
                        HorizontalAlignment="Left"
                        Content="Save password"
                        IsEnabled="False" />

                </Grid>
            </StackPanel>
        </Border>

        <!-- View actions -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                Classes="twain-command-button"
                Content="Close"
                Click="CloseButton_Click" />

        </StackPanel>

    </Grid>
</UserControl>
