<Window
    x:Class="Twain.UI.Profiles.ProfilesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:profiles="clr-namespace:Twain.UI.Profiles"
    Title="Profiles"
    Width="760"
    Height="520"
    MinWidth="600"
    MinHeight="440"
    WindowStartupLocation="CenterOwner">

    <Grid
        Margin="16"
        RowDefinitions="*,Auto,Auto,Auto"
        RowSpacing="12">

        <!-- Saved profiles -->
        <DataGrid
            x:Name="ProfilesDataGrid"
            Grid.Row="0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            GridLinesVisibility="Horizontal"
            SelectionChanged="ProfilesDataGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="ID"
                    Binding="{Binding ID, x:DataType=profiles:ProfileListItem}"
                    Width="Auto" />

                <DataGridTextColumn
                    Header="Username"
                    Binding="{Binding Username, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Password saved?"
                    Binding="{Binding PasswordSaved, x:DataType=profiles:ProfileListItem}"
                    Width="*" />

                <DataGridTextColumn
                    Header="Default settings"
                    Binding="{Binding DefaultSettings, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />

                <DataGridTextColumn
                    Header="Notes"
                    Binding="{Binding Notes, x:DataType=profiles:ProfileListItem}"
                    Width="2*" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Saved profile actions -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                x:Name="LoginButton"
                Content="Login"
                MinWidth="80"
                IsEnabled="False"
                Click="LoginButton_Click" />

            <Button
                x:Name="AddButton"
                Content="Add..."
                MinWidth="80"
                Click="AddButton_Click" />

            <Button
                x:Name="EditButton"
                Content="Edit..."
                MinWidth="80"
                IsEnabled="False"
                Click="EditButton_Click" />

            <Button
                x:Name="DeleteButton"
                Content="Delete"
                MinWidth="80"
                IsEnabled="False"
                Click="DeleteButton_Click" />
        </StackPanel>

        <!-- Quick login -->
        <GroupBox
            Grid.Row="2"
            Header="Quick login">

            <Grid
                Margin="8"
                ColumnDefinitions="Auto,*,Auto"
                RowDefinitions="Auto,Auto,Auto"
                ColumnSpacing="8"
                RowSpacing="8">

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Username:" />

                <TextBox
                    x:Name="QuickLoginUsernameTextBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    Grid.ColumnSpan="2"
                    TextChanged="QuickLoginCredentials_TextChanged" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Password:" />

                <TextBox
                    x:Name="QuickLoginPasswordTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    PasswordChar="●"
                    TextChanged="QuickLoginCredentials_TextChanged" />

                <Button
                    x:Name="QuickLoginButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    MinWidth="80"
                    Content="Login"
                    IsEnabled="False"
                    Click="QuickLoginButton_Click" />

                <CheckBox
                    x:Name="SaveQuickLoginProfileCheckBox"
                    Grid.Row="2"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    Content="Save this account"
                    IsCheckedChanged="SaveQuickLoginProfileCheckBox_IsCheckedChanged" />

                <CheckBox
                    x:Name="SaveQuickLoginPasswordCheckBox"
                    Grid.Row="2"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Content="Save password"
                    IsEnabled="False" />
            </Grid>
        </GroupBox>

        <!-- Window actions -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Content="Close"
                MinWidth="80"
                Click="CloseButton_Click" />
        </StackPanel>

    </Grid>
</Window>