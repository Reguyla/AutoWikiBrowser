
<Window
    x:Class="Twain.UI.Profiles.ProfileEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Profile"
    Width="440"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Username -->
        <TextBlock
            Grid.Row="0"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Username:" />

        <TextBox
            x:Name="UsernameTextBox"
            Grid.Row="0"
            Grid.Column="1"
            MinWidth="280" />

        <!-- Password -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Password:" />

        <TextBox
            x:Name="PasswordTextBox"
            Grid.Row="1"
            Grid.Column="1"
            PasswordChar="●" />

        <!-- Default settings -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Default settings:" />

        <TextBox
            x:Name="DefaultSettingsTextBox"
            Grid.Row="2"
            Grid.Column="1" />

        <!-- Notes -->
        <TextBlock
            Grid.Row="3"
            Grid.Column="0"
            VerticalAlignment="Top"
            Text="Notes:" />

        <TextBox
            x:Name="NotesTextBox"
            Grid.Row="3"
            Grid.Column="1"
            MinHeight="70"
            AcceptsReturn="True"
            TextWrapping="Wrap" />

        <!-- Actions -->
        <StackPanel
            Grid.Row="4"
            Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,6,0,0"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

            <Button
                Classes="twain-primary-button"
                Content="Save"
                IsDefault="True"
                Click="SaveButton_Click" />

        </StackPanel>

    </Grid>
</Window>
