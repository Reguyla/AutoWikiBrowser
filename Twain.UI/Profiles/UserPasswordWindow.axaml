<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Twain.UI.Profiles.UserPasswordWindow"
    mc:Ignorable="d"
    d:DesignWidth="420"
    d:DesignHeight="150"
    Width="420"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Password">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <TextBlock
            x:Name="PromptTextBlock"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="PasswordTextBox"
            Grid.Row="1"
            PasswordChar="●" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Width="90"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Width="90"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>