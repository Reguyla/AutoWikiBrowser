
<UserControl
    x:Class="Twain.UI.ArticleList.ArticleListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ArticleList"
    x:DataType="vm:ArticleListViewModel"
    d:DesignWidth="320"
    d:DesignHeight="500"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ArticleListViewModel />
    </Design.DataContext>

    <Grid
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <ListBox
            Grid.Row="0"
            Background="{DynamicResource TwainControlBackgroundBrush}"
            BorderBrush="{DynamicResource TwainBorderBrush}"
            BorderThickness="{DynamicResource TwainBorderThickness}"
            ItemsSource="{Binding Articles}"
            SelectedItem="{Binding SelectedArticle}" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

        <Button
            Classes="twain-command-button"
            Command="{Binding AddArticleCommand}"
            Content="Add" />

        <Button
            Classes="twain-command-button"
            Command="{Binding RemoveSelectedArticleCommand}"
            Content="Remove" />

        </StackPanel>

    </Grid>

</UserControl>
