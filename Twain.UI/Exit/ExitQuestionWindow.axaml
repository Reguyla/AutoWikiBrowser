
<Window
    x:Class="Twain.UI.Exit.ExitQuestionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="720"
    Height="315"
    CanResize="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Title="Exit?"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="32"
        RowDefinitions="Auto,Auto,Auto,Auto,*"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Exit prompt -->
        <TextBlock
            x:Name="PromptText"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!-- Session statistics -->
        <TextBlock
            x:Name="TimeAndEditsText"
            Grid.Row="1"
            HorizontalAlignment="Stretch"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!-- Settings reminder -->
        <TextBlock
            Grid.Row="2"
            HorizontalAlignment="Stretch"
            Text="Have you remembered to save your settings?"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!-- Exit preference -->
        <CheckBox
            x:Name="DontAskAgainCheckBox"
            Grid.Row="3"
            HorizontalAlignment="Center"
            Content="_Don't ask again" />

        <!-- Exit commands -->
        <StackPanel
            Grid.Row="4"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingLarge}">

            <Button
                Classes="twain-primary-button"
                Width="200"
                Height="55"
                Content="E_xit"
                IsDefault="True"
                Click="ExitButton_Click" />

            <Button
                Classes="twain-command-button"
                Width="200"
                Height="55"
                Content="Go back"
                IsCancel="True"
                Click="GoBackButton_Click" />

        </StackPanel>

    </Grid>
</Window>
