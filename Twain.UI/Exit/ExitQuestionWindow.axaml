<Window
    x:Class="Twain.UI.Exit.ExitQuestionWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="720"
    Height="315"
    CanResize="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Title="Exit?">

    <Grid
        Margin="32"
        RowDefinitions="Auto,Auto,Auto,Auto,*">

        <TextBlock
            x:Name="PromptText"
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <TextBlock
            x:Name="TimeAndEditsText"
            Grid.Row="1"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            Margin="0,12,0,0"
            HorizontalAlignment="Stretch"
            Text="Have you remembered to save your settings?"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <CheckBox
            x:Name="DontAskAgainCheckBox"
            Grid.Row="3"
            Margin="192,12,0,0"
            HorizontalAlignment="Left"
            Content="_Don't ask again" />

        <StackPanel
            Grid.Row="4"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Orientation="Horizontal"
            Spacing="16">

            <Button
                Width="200"
                Height="55"
                Content="E_xit"
                IsDefault="True"
                Click="ExitButton_Click" />

            <Button
                Width="200"
                Height="55"
                Content="Go back"
                IsCancel="True"
                Click="GoBackButton_Click" />

        </StackPanel>

    </Grid>

</Window>