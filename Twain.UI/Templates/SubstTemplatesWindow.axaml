
<Window
    x:Class="Twain.UI.Templates.SubstTemplatesWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    Height="520"
    MinWidth="420"
    MinHeight="420"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Substitute Templates"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Template list -->
        <Border
            Grid.Row="0"
            Classes="twain-section"
            Margin="0"
            MinHeight="0">

            <Grid
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Row="0"
                    Classes="twain-section-heading"
                    Text="Templates to substitute" />

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Auto">

                    <TextBox
                        x:Name="TemplatesTextBox"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        MinHeight="0" />

                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Substitution options -->
        <Border
            Grid.Row="1"
            Classes="twain-section"
            Margin="0">

            <StackPanel
                Spacing="{DynamicResource TwainSpacingSmall}">

                <TextBlock
                    Classes="twain-section-heading"
                    Text="Substitution options" />

                <CheckBox
                    x:Name="IgnoreUnformattedCheckBox"
                    Content="Ignore unformatted text" />

                <CheckBox
                    x:Name="ExpandRecursivelyCheckBox"
                    Content="Expand templates recursively"
                    Click="ExpandRecursivelyCheckBox_Changed" />

                <CheckBox
                    x:Name="IncludeCommentsCheckBox"
                    Content="Include comments" />

            </StackPanel>
        </Border>

        <!-- Actions -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,Auto,*,Auto,Auto"
            ColumnSpacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Grid.Column="0"
                Classes="twain-command-button"
                Content="_Clear"
                Click="ClearButton_Click" />

            <Button
                Grid.Column="1"
                Classes="twain-command-button"
                Content="_Reset"
                Click="ResetButton_Click" />

            <Button
                Grid.Column="3"
                Classes="twain-primary-button"
                Content="_OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Grid.Column="4"
                Classes="twain-command-button"
                Content="_Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </Grid>

    </Grid>
</Window>
