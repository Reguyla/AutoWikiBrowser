
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    x:Class="Twain.UI.Alerts.ArticleAlertsView"
    x:DataType="vm:WorkspaceViewModel"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <UserControl.Styles>

        <!-- Interactive alert cards -->
        <Style Selector="Border.twain-alert-item">
            <Setter
                Property="Background"
                Value="{DynamicResource TwainSurfaceBrush}" />
        </Style>

        <Style Selector="Border.twain-alert-item:pointerover">
            <Setter
                Property="Background"
                Value="{DynamicResource TwainSelectionBrush}" />
        </Style>

    </UserControl.Styles>

    <!-- Workspace pane frame -->
    <Border
        Background="{DynamicResource TwainSurfaceBrush}"
        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
        BorderThickness="1"
        CornerRadius="0">

        <Grid RowDefinitions="Auto,*">

            <!-- Pane header -->
            <Border
                Grid.Row="0"
                MinHeight="{DynamicResource TwainPaneHeaderHeight}"
                Padding="12,4"
                Background="{DynamicResource TwainPaneHeaderBrush}"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="0,0,0,1">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                    <TextBlock
                        Grid.Column="0"
                        Text="Article Alerts"
                        FontWeight="SemiBold"
                        VerticalAlignment="Center" />

                    <!-- Alert count -->
                    <Border
                        Grid.Column="1"
                        MinWidth="24"
                        MinHeight="20"
                        Padding="6,2"
                        CornerRadius="10"
                        Background="{DynamicResource TwainSurfaceBrush}"
                        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="{Binding Options.Alerts.Count}"
                            FontSize="{DynamicResource TwainFontSizeSmall}"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TwainTextSecondaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    </Border>

                </Grid>
            </Border>

            <!-- Alert results -->
            <ScrollViewer
                Grid.Row="1"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">

                <ItemsControl
                    Margin="6"
                    ItemsSource="{Binding Options.Alerts}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:CompileBindings="False">

                            <Border
                                Classes="twain-alert-item"
                                Margin="0,0,0,4"
                                Padding="8,6"
                                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource TwainControlCornerRadius}"
                                Cursor="Hand"
                                PointerPressed="AlertItem_PointerPressed">

                                <TextBlock
                                    Text="{Binding}"
                                    TextWrapping="Wrap" />

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>
