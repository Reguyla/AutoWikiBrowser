
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Twain.UI.PasteMore"
    x:Class="Twain.UI.PasteMore.ConfigurePasteMoreItemsWindow"
    x:DataType="local:ConfigurePasteMoreItemsWindow"
    Title="Paste More items"
    Width="420"
    Height="420"
    MinWidth="360"
    MinHeight="320"
    WindowStartupLocation="CenterOwner"
    CanResize="True"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Configurable Paste More entries -->
        <ScrollViewer
            Grid.Row="0"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate
                        x:DataType="local:PasteMoreItemRow">

                        <Grid
                            Margin="0,3"
                            ColumnDefinitions="40,*"
                            ColumnSpacing="{DynamicResource TwainSpacingSmall}">

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Text="{Binding Number}" />

                            <TextBox
                                Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                Text="{Binding Text, Mode=TwoWay}" />

                        </Grid>

                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </ScrollViewer>

        <!-- Completion commands -->
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                Classes="twain-primary-button"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>
</Window>
