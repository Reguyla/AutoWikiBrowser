
<Window
    x:Class="Twain.UI.Logging.UploadingPleaseWaitWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="130"
    CanResize="False"
    ShowInTaskbar="False"
    SystemDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner"
    Title="Uploading..."
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}"
        VerticalAlignment="Center">

        <!-- Upload status message -->
        <TextBlock
            Grid.Row="0"
            HorizontalAlignment="Center"
            Text="Your log is being uploaded, please wait"
            TextAlignment="Center"
            TextWrapping="Wrap" />

        <!-- Indeterminate upload progress -->
        <ProgressBar
            Grid.Row="1"
            Height="8"
            HorizontalAlignment="Stretch"
            IsIndeterminate="True" />

    </Grid>
</Window>
