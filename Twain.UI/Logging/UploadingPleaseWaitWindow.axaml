<Window
    x:Class="Twain.UI.Logging.UploadingPleaseWaitWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="130"
    CanResize="False"
    ShowInTaskbar="False"
    SystemDecorations="BorderOnly"
    WindowStartupLocation="CenterOwner"
    Title="Uploading...">

    <Grid Margin="16"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="16">

        <Border Grid.Column="0"
                Width="64"
                Height="64"
                VerticalAlignment="Center">

            <TextBlock Text="..."
                       FontSize="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <TextBlock Grid.Column="1"
                   VerticalAlignment="Center"
                   Text="Your log is being uploaded, please wait"
                   TextWrapping="Wrap" />
    </Grid>
</Window>