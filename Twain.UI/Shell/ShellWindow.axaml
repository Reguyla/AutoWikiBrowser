<Window
    x:Class="Twain.UI.Views.Shell.ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.Shell"
    xmlns:workspaceViews="using:Twain.UI.Views.Workspaces"
    x:DataType="vm:ShellViewModel"
    Width="1100"
    Height="700"
    MinWidth="700"
    MinHeight="500"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}"
    Icon="/Assets/Twainlogo.ico"
    Title="Twain"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ShellViewModel />
    </Design.DataContext>

    <workspaceViews:WorkspaceView
        DataContext="{Binding Workspace}" />

</Window>