<Window
    x:Name="TwainShellWindow"
    x:Class="Twain.UI.Views.Shell.ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.Shell"
    xmlns:workspaceViews="using:Twain.UI.Views.Workspaces"
    xmlns:processingControls="using:Twain.UI.Controls.Processing"
    x:DataType="vm:ShellViewModel"
    Width="1100"
    Height="700"
    MinWidth="700"
    MinHeight="500"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}"
    Icon="/Assets/Twainlogo.ico"
    Title="{Binding WindowTitle}"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ShellViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Main toolbar: presentation is supplied by shared Twain styles. -->
        <Border
            Grid.Row="0"
            Padding="12,8"
            Background="{DynamicResource TwainToolbarBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Grid
                ColumnDefinitions="Auto,Auto,*,Auto"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <!-- Always-visible processing toolbar toggle. -->
                <Button
                    Grid.Column="0"
                    Classes="twain-command-button"
                    MinWidth="36"
                    Padding="8,6"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleToolbarCommand}"
                    Content="{Binding ToolbarToggleText}"
                    ToolTip.Tip="Show or hide processing buttons" />

                <!-- Shared article-processing toolbar. -->
                <processingControls:ProcessingToolbarView
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    DataContext="{Binding Workspace.Options}"
                    IsVisible="{Binding #TwainShellWindow.DataContext.IsToolbarExpanded,
                                        DataType=vm:ShellViewModel}" />


                <!-- Update status: occupies the remaining toolbar width. -->
                <TextBlock
                    Grid.Column="2"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    Text="{Binding UpdateStatusMessage}"
                    TextWrapping="Wrap" />


                <!-- Authentication and update controls. -->
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Spacing="{DynamicResource TwainSpacingSmall}">

                        <!-- Keep both a symbol and text for login status. -->
                        <TextBlock
                            x:Name="AuthenticationIndicator"
                            Classes.logged-in="{Binding IsLoggedIn}"
                            VerticalAlignment="Center"
                            FontSize="18"
                            FontWeight="Bold">
                            <TextBlock.Styles>
                                <Style Selector="TextBlock">
                                    <Setter Property="Text" Value="✕" />
                                    <Setter Property="Foreground" Value="#C62828" />
                                </Style>
                                <Style Selector="TextBlock.logged-in">
                                    <Setter Property="Text" Value="✓" />
                                    <Setter Property="Foreground" Value="#2E7D32" />
                                </Style>
                            </TextBlock.Styles>
                        </TextBlock>

                        <StackPanel
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                                Text="{Binding LoginStatusText}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                                Text="{Binding ActiveWikiText}" />
                        </StackPanel>
                    </StackPanel>

                    <Button
                        Classes="twain-command-button"
                        VerticalAlignment="Center"
                        Click="LoginProfilesMenuItem_Click"
                        Content="{Binding LoginButtonText}" />

                    <Button
                        Classes="twain-command-button"
                        VerticalAlignment="Center"
                        Command="{Binding InstallUpdateCommand}"
                        Content="Update and Restart"
                        IsVisible="{Binding IsUpdateAvailable}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main workspace: existing navigation and editing layout. -->
        <workspaceViews:WorkspaceView
            x:Name="MainWorkspaceView"
            Grid.Row="1"
            DataContext="{Binding Workspace}" />

    </Grid>
</Window>
