<Window
    x:Class="Twain.UI.Views.Shell.ShellWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.Shell"
    xmlns:workspaceViews="using:Twain.UI.Views.Workspaces"
    xmlns:processingControls="using:Twain.UI.Controls.Processing"
    x:DataType="vm:ShellViewModel"
    Width="1100"
    Height="700"
    MinWidth="700"
    MinHeight="500"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}"
    Icon="/Assets/Twainlogo.ico"
    Title="{Binding WindowTitle}"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:ShellViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Main toolbar -->
        <Border
            Grid.Row="0"
            Padding="{DynamicResource TwainContentPadding}"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Border.Styles>
                <!-- Styles are scoped to the six primary workflow buttons. -->
                <Style Selector="Button.workflow-action">
                    <Setter Property="MinWidth" Value="110" />
                    <Setter Property="Height" Value="44" />
                    <Setter Property="Padding" Value="12,6" />
                    <Setter Property="Background" Value="{DynamicResource TwainRaisedSurfaceBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TwainBorderSubtleBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="CornerRadius" Value="{DynamicResource TwainControlCornerRadius}" />
                    <Setter Property="Foreground" Value="{DynamicResource TwainTextPrimaryBrush}" />
                </Style>

                <Style Selector="Button.workflow-action:pointerover">
                    <Setter Property="Background" Value="{DynamicResource TwainSelectionBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TwainAccentHoverBrush}" />
                </Style>

                <Style Selector="Button.workflow-action:pressed">
                    <Setter Property="Background" Value="{DynamicResource TwainSelectionBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TwainAccentPressedBrush}" />
                </Style>

                <Style Selector="Button.workflow-action:disabled">
                    <Setter Property="Background" Value="{DynamicResource TwainControlBackgroundDisabledBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TwainTextDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource TwainBorderSubtleBrush}" />
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <!-- Always-visible processing toolbar toggle -->
                <Button
                    Grid.Column="0"
                    MinWidth="36"
                    Padding="8,6"
                    VerticalAlignment="Center"
                    Command="{Binding ToggleToolbarCommand}"
                    Content="{Binding ToolbarToggleText}"
                    ToolTip.Tip="Show or hide processing buttons" />

                <!-- Shared article-processing toolbar -->
                <processingControls:ProcessingToolbarView
                    Grid.Column="1"
                    DataContext="{Binding Workspace.Options}"
                    IsVisible="{Binding $parent[Window].DataContext.IsToolbarExpanded}" />

                <!-- Update status -->
                <TextBlock
                    Grid.Column="2"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Text="{Binding UpdateStatusMessage}"
                    TextWrapping="Wrap" />

                <!-- Authentication controls -->
                <StackPanel
                    Grid.Column="3"
                    Orientation="Horizontal"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource TwainSpacingMedium}">

                <!-- Authentication status indicator -->
                <TextBlock
                    x:Name="AuthenticationIndicator"
                    Classes.logged-in="{Binding IsLoggedIn}"
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="Bold">

                    <TextBlock.Styles>
                        <Style Selector="TextBlock">
                            <Setter Property="Text" Value="✕" />
                            <Setter Property="Foreground" Value="#C62828" />
                        </Style>

                        <Style Selector="TextBlock.logged-in">
                            <Setter Property="Text" Value="✓" />
                            <Setter Property="Foreground" Value="#2E7D32" />
                        </Style>
                    </TextBlock.Styles>

                </TextBlock>

                    <!-- Existing authentication information -->
                    <StackPanel
                        VerticalAlignment="Center"
                        Spacing="2">

                        <TextBlock
                            Foreground="{DynamicResource TwainTextPrimaryBrush}"
                            Text="{Binding LoginStatusText}" />

                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TwainTextSecondaryBrush}"
                            Text="{Binding ActiveWikiText}" />

                    </StackPanel>

                </StackPanel>

                    <Button
                        Classes="twain-command-button"
                        Click="LoginProfilesMenuItem_Click"
                        Content="{Binding LoginButtonText}" />

                    <Button
                        Classes="twain-command-button"
                        Command="{Binding InstallUpdateCommand}"
                        Content="Update and Restart"
                        IsVisible="{Binding IsUpdateAvailable}" />

                </StackPanel>

            </Grid>
        </Border>

        <!-- Main workspace -->
        <workspaceViews:WorkspaceView
            x:Name="MainWorkspaceView"
            Grid.Row="1"
            DataContext="{Binding Workspace}" />

    </Grid>

</Window>
