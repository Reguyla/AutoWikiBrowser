
<Window
    x:Class="Twain.UI.Authentication.AuthenticationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Authentication Required"
    Width="440"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Dialog heading and instructions -->
        <StackPanel
            Grid.Row="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Text="Authentication Required"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}" />

            <TextBlock
                Text="Enter the HTTP authentication credentials for this site."
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                TextWrapping="Wrap" />

        </StackPanel>

        <!-- Credential fields -->
        <Border
            Grid.Row="1"
            Padding="16"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <Grid
                ColumnDefinitions="Auto,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                RowSpacing="{DynamicResource TwainSpacingMedium}">

                <!-- Username -->
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Username:" />

                <TextBox
                    x:Name="UsernameTextBox"
                    Grid.Row="0"
                    Grid.Column="1"
                    MinWidth="240" />

                <!-- Password -->
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Password:" />

                <TextBox
                    x:Name="PasswordTextBox"
                    Grid.Row="1"
                    Grid.Column="1"
                    PasswordChar="●" />

            </Grid>
        </Border>

        <!-- Dialog commands -->
        <Border
            Grid.Row="2"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingMedium}">

                <Button
                    Classes="twain-command-button"
                    Content="Cancel"
                    IsCancel="True" />

                <Button
                    Classes="twain-primary-button"
                    Content="Login"
                    IsDefault="True"
                    Click="LoginButton_Click" />

            </StackPanel>
        </Border>

    </Grid>
</Window>
