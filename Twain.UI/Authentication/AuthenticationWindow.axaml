
<Window
    x:Class="Twain.UI.Authentication.AuthenticationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Authentication Required"
    Width="420"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,Auto"
        ColumnDefinitions="Auto,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Instructions -->
        <TextBlock
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Text="Enter the HTTP authentication credentials for this site."
            TextWrapping="Wrap" />

        <!-- Username -->
        <TextBlock
            Grid.Row="1"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Username:" />

        <TextBox
            x:Name="UsernameTextBox"
            Grid.Row="1"
            Grid.Column="1"
            MinWidth="260" />

        <!-- Password -->
        <TextBlock
            Grid.Row="2"
            Grid.Column="0"
            VerticalAlignment="Center"
            Text="Password:" />

        <TextBox
            x:Name="PasswordTextBox"
            Grid.Row="2"
            Grid.Column="1"
            PasswordChar="●" />

        <!-- Commands -->
        <Button
            Grid.Row="3"
            Grid.Column="1"
            Classes="twain-primary-button"
            HorizontalAlignment="Right"
            Content="Login"
            IsDefault="True"
            Click="LoginButton_Click" />

    </Grid>
</Window>
