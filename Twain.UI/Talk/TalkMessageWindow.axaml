
<Window
    x:Class="Twain.UI.Talk.TalkMessageWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="453"
    Height="165"
    CanResize="False"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="CenterScreen"
    Title="New messages"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Talk page notification -->
        <Border
            Grid.Row="0"
            Classes="twain-section"
            Margin="0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">

            <TextBlock
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Text="You have new messages."
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="16"
                FontWeight="SemiBold" />

        </Border>

        <!-- View messages -->
        <Button
            Grid.Row="1"
            Classes="twain-primary-button"
            MinWidth="140"
            HorizontalAlignment="Center"
            Content="_View"
            IsDefault="True"
            Click="ViewButton_Click" />

    </Grid>

</Window>
