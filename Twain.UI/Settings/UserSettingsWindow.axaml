<Window
    x:Class="Twain.UI.Settings.UserSettingsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="680"
    MinWidth="680"
    MinHeight="560"
    CanResize="True"
    WindowStartupLocation="CenterOwner"
    Title="User Settings"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid RowDefinitions="*,Auto">

        <TabControl Classes="twain-tabs"
                    Margin="{DynamicResource TwainContentPadding}">

            <TabItem Classes="twain-tab" Header="Site">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Classes="twain-section" Margin="0">
                    <StackPanel Margin="0"
                                Spacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock Classes="twain-section-heading" Text="Wiki" />

                        <Grid ColumnDefinitions="180,*"
                              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                              ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                              RowSpacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Project:" />

                            <ComboBox x:Name="ProjectComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1"
                                      SelectionChanged="ProjectComboBox_SelectionChanged" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Language:" />

                            <ComboBox x:Name="LanguageComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      IsEditable="False" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Custom project:" />

                            <Grid Grid.Row="2"
                                  Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="{DynamicResource TwainSpacingSmall}">

                                <ComboBox x:Name="CustomProjectComboBox"
                                          IsEditable="True"
                                          PropertyChanged="CustomProjectComboBox_PropertyChanged" />

                                <TextBlock x:Name="ProjectPostfixTextBlock"
                                           Grid.Column="1"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Protocol:" />

                            <ComboBox x:Name="ProtocolComboBox"
                                      Grid.Row="3"
                                      Grid.Column="1">
                                <ComboBoxItem Content="https://" />
                                <ComboBoxItem Content="http://" />
                            </ComboBox>

                            <TextBlock Grid.Row="4"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Domain:" />

                            <Grid Grid.Row="4"
                                  Grid.Column="1"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="{DynamicResource TwainSpacingSmall}">

                                <CheckBox x:Name="UseCustomDomainCheckBox"
                                          VerticalAlignment="Center"
                                          Content="Use custom domain"
                                          Click="UseCustomDomainCheckBox_Click" />

                                <TextBox x:Name="DomainTextBox"
                                         Grid.Column="1" />
                            </Grid>

                            <CheckBox x:Name="SuppressAwbCheckBox"
                                      Grid.Row="5"
                                      Grid.Column="1"
                                      Content="Suppress Twain attribution" />
                        </Grid>

                    </StackPanel>
                                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Classes="twain-section" Margin="0">
                    <StackPanel Margin="0"
                                Spacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock Classes="twain-section-heading" Text="Application behavior" />

                        <CheckBox x:Name="AlwaysConfirmExitCheckBox"
                                  Content="Always confirm before exiting" />

                        <CheckBox x:Name="PrivacyCheckBox"
                                  Content="Disable usage reporting" />

                        <CheckBox x:Name="LowPriorityCheckBox"
                                  Content="Run with low thread priority" />

                        <CheckBox x:Name="FlashCheckBox"
                                  Content="Flash the application for alerts" />

                        <CheckBox x:Name="BeepCheckBox"
                                  Content="Beep for alerts" />

                        <CheckBox x:Name="MinimizeCheckBox"
                                  Content="Minimize when appropriate" />

                        <CheckBox x:Name="LoggingCheckBox"
                                  Content="Enable logging" />

                        <CheckBox x:Name="SaveArticleListCheckBox"
                                  Content="Save article list" />

                        <CheckBox x:Name="IgnoreNoBotsCheckBox"
                                  Content="Ignore {{nobots}}" />

                        <CheckBox x:Name="ShowTimerCheckBox"
                                  Content="Show processing timer" />

                        <CheckBox x:Name="ClearPageListCheckBox"
                                  Content="Clear page list when project changes" />
                    </StackPanel>
                                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Editor">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Classes="twain-section" Margin="0">
                    <StackPanel Margin="0"
                                Spacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock Classes="twain-section-heading" Text="Editor" />

                        <Button Classes="twain-command-button"
                                 x:Name="ChooseFontButton"
                                HorizontalAlignment="Left"
                                Content="Choose editor font..." />

                        <Separator />

                        <TextBlock Text="Automatic save"
                                   FontWeight="SemiBold" />

                        <CheckBox x:Name="AutoSaveEditCheckBox"
                                  Content="Automatically save editor text" />

                        <Grid ColumnDefinitions="180,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                              RowSpacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Save interval:" />

                            <NumericUpDown x:Name="AutoSavePeriodNumericUpDown"
                                           Minimum="30"
                                           Maximum="300"
                                           Value="30" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Save file:" />

                            <Grid Grid.Row="1"
                                  Grid.Column="1"
                                  ColumnDefinitions="*,Auto"
                                  ColumnSpacing="{DynamicResource TwainSpacingSmall}">

                                <TextBox x:Name="AutoSaveFileTextBox" />

                                <Button Classes="twain-command-button"
                                         x:Name="ChooseAutoSaveFileButton"
                                        Grid.Column="1"
                                        Content="Browse..." />
                            </Grid>
                        </Grid>
                    </StackPanel>
                                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Processing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Classes="twain-section" Margin="0">
                    <StackPanel Margin="0"
                                Spacing="{DynamicResource TwainSpacingMedium}">

                        <TextBlock Classes="twain-section-heading" Text="Article behavior" />

                        <Grid ColumnDefinitions="260,*"
                              RowDefinitions="Auto,Auto,Auto,Auto"
                              ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                              RowSpacing="{DynamicResource TwainSpacingMedium}">

                            <TextBlock Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="List Comparer article list:" />

                            <ComboBox x:Name="ListComparerModeComboBox"
                                      Grid.Row="0"
                                      Grid.Column="1" />

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="List Splitter article list:" />

                            <ComboBox x:Name="ListSplitterModeComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1" />

                            <TextBlock Grid.Row="2"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="Database Scanner article list:" />

                            <ComboBox x:Name="DatabaseScannerModeComboBox"
                                      Grid.Row="2"
                                      Grid.Column="1" />

                            <TextBlock Grid.Row="3"
                                       Grid.Column="0"
                                       VerticalAlignment="Center"
                                       Text="When an article is loaded:" />

                            <ComboBox x:Name="OnLoadComboBox"
                                      Grid.Row="3"
                                      Grid.Column="1"
                                      SelectionChanged="OnLoadComboBox_SelectionChanged" />
                        </Grid>

                        <CheckBox x:Name="DiffInBotModeCheckBox"
                                  Content="Generate diff in bot mode" />

                        <CheckBox x:Name="AddUsingAwbToActionSummariesCheckBox"
                                  Content="Add Twain attribution to action summaries" />
                    </StackPanel>
                                    </Border>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Alerts">
                <Border Classes="twain-section" Margin="0">
                  <Grid RowDefinitions="Auto,*,Auto"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock Classes="twain-section-heading" Text="Enabled alerts" />

                    <ScrollViewer Grid.Row="1">
                        <StackPanel x:Name="AlertsPanel"
                                    Spacing="{DynamicResource TwainSpacingSmall}" />
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Text="When no alerts are selected, all alerts are treated as enabled."
                               TextWrapping="Wrap"
                               Opacity="0.75" />
                  </Grid>
                </Border>
            </TabItem>

        </TabControl>

        <Grid Grid.Row="1"
              Margin="{DynamicResource TwainContentPadding}"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="{DynamicResource TwainSpacingSmall}">

        <Button Classes="twain-primary-button"
                 x:Name="OkButton"
                Grid.Column="1"
                MinWidth="90"
                IsDefault="True"
                Click="OkButton_Click"
                Content="OK" />

        <Button Classes="twain-command-button"
                 x:Name="CancelButton"
                Grid.Column="2"
                MinWidth="90"
                IsCancel="True"
                Click="CancelButton_Click"
                Content="Cancel" />
        </Grid>

    </Grid>

</Window>