
<Window
    x:Class="Twain.UI.Summaries.SummaryEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="633"
    Height="365"
    CanResize="False"
    Title="Default Edit Summary editor"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Description -->
        <TextBlock
            Grid.Row="0"
            Text="Default Edit Summaries (Twain will use these as the start of the page edit summary):"
            TextWrapping="Wrap" />

        <!-- Edit summaries -->
        <Border
            Grid.Row="1"
            Classes="twain-section"
            Margin="0"
            Padding="0"
            MinHeight="0">

            <ScrollViewer
                VerticalScrollBarVisibility="Visible"
                HorizontalScrollBarVisibility="Auto">

                <TextBox
                    x:Name="SummariesTextBox"
                    AcceptsReturn="True"
                    AcceptsTab="True"
                    TextWrapping="NoWrap"
                    MinHeight="0" />

            </ScrollViewer>

        </Border>

        <!-- Actions -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="Auto,*,Auto,Auto"
            ColumnSpacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Grid.Column="0"
                Classes="twain-command-button"
                Content="_Sort"
                Click="SortButton_Click" />

            <Button
                Grid.Column="2"
                Classes="twain-primary-button"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Grid.Column="3"
                Classes="twain-command-button"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </Grid>

    </Grid>

</Window>
