<Window
    x:Class="Twain.UI.Summaries.SummaryEditorWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="633"
    Height="365"
    CanResize="False"
    Title="Default Edit Summary editor">

    <Grid
        Margin="12"
        RowDefinitions="Auto,*,Auto">

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,6"
            Text="Default _Edit Summaries (AWB will use these as the start of the page edit summary):" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Visible"
            HorizontalScrollBarVisibility="Auto">

            <TextBox
                x:Name="SummariesTextBox"
                AcceptsReturn="True"
                AcceptsTab="True"
                TextWrapping="NoWrap" />

        </ScrollViewer>

        <Grid
            Grid.Row="2"
            Margin="0,6,0,0"
            ColumnDefinitions="Auto,*,Auto,Auto">

            <Button
                Grid.Column="0"
                Width="75"
                Content="_Sort"
                Click="SortButton_Click" />

            <Button
                Grid.Column="2"
                Width="75"
                Margin="0,0,6,0"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Grid.Column="3"
                Width="75"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </Grid>

    </Grid>

</Window>