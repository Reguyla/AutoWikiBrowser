
<Window
    x:Class="Twain.UI.Shutdown.ShutdownNotificationWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="880"
    Height="262"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Title="Shutdown notification"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Shutdown message -->
        <TextBlock
            x:Name="PromptText"
            Grid.Row="0"
            TextWrapping="Wrap"
            VerticalAlignment="Top" />

        <!-- Shutdown countdown -->
        <Border
            Grid.Row="1"
            Classes="twain-section"
            HorizontalAlignment="Center"
            Margin="0"
            Padding="16,10">

            <TextBlock
                x:Name="TimerText"
                HorizontalAlignment="Center"
                FontSize="16"
                FontWeight="SemiBold"
                Text="Time until shutdown: 120" />

        </Border>

        <!-- Actions -->
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <Button
                Classes="twain-primary-button"
                MinWidth="120"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                MinWidth="120"
                Content="Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>

    </Grid>

</Window>
