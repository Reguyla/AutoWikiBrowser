<UserControl
    x:Class="Twain.UI.Views.Workspaces.WorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    xmlns:workspaceControls="using:Twain.UI.Controls.Workspaces"
    x:DataType="vm:WorkspaceViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
        Hosts each workspace pane through the shared pane presentation control.
        -->
        <DataTemplate
            x:Key="WorkspacePaneTemplate"
            x:DataType="vm:PaneViewModel">

            <workspaceControls:WorkspacePaneHost />

        </DataTemplate>

    </UserControl.Resources>

<Grid
    Background="{DynamicResource TwainWorkspaceBackgroundBrush}"
    ColumnDefinitions="220,8,*"
    RowDefinitions="*,Auto" >

    <!--
    Left navigation.

    This will replace the traditional File/Edit/View/Tools/Help menu
    structure and provide access to editing, options, settings, tools,
    plugins, diagnostics, and help.
    -->

    <Border
        Grid.Row="0"
        Grid.RowSpan="2"
        Grid.Column="0"
        Padding="12"
        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
        BorderThickness="0,0,1,0">

        <StackPanel Spacing="8">

            <TextBlock
                Margin="4,4,4,12"
                FontSize="{DynamicResource TwainFontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                Text="Twain" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Editing" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Article List" />

            <TextBlock
                Margin="4,12,4,4"
                FontWeight="SemiBold"
                Text="Options" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="General" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="More" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Disambiguation" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Skip Rules" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Start Options" />

            <Separator Margin="0,8" />

            <TextBlock
                Margin="4,0,4,4"
                FontWeight="SemiBold"
                Text="User Settings" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Profiles" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Preferences" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Bot Settings" />

            <Separator Margin="0,8" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Custom Modules" />

            <TextBlock
                Margin="4,8,4,4"
                FontWeight="SemiBold"
                Text="Tools" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="List Tools" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Database Scanner" />

            <Button
                Margin="16,0,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Regex Tester" />

            <Separator Margin="0,8" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Plugins" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="Logging &amp; Diagnostics" />

            <Button
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Content="About" />

        </StackPanel>

    </Border>

    <!-- Separator between navigation and workspace. -->

    <GridSplitter
        Grid.Row="0"
        Grid.RowSpan="2"
        Grid.Column="1"
        Width="8"
        HorizontalAlignment="Stretch"
        Background="{DynamicResource TwainBorderSubtleBrush}"
        ResizeDirection="Columns"
        ResizeBehavior="PreviousAndNext" />

    <!--
    Editing workspace.

    Diff occupies the entire upper region.
    Article List, Monaco, and Article Alerts occupy the lower region.
    -->

    <Grid
        Grid.Row="0"
        Grid.Column="2"
        Margin="12,0,12,8"
        RowDefinitions="*,8,*">

        <!-- Diff -->

        <ItemsControl
            Grid.Row="0"
            ItemTemplate="{StaticResource WorkspacePaneTemplate}"
            ItemsSource="{Binding DocumentPanes}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Grid />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

        </ItemsControl>

        <GridSplitter
            Grid.Row="1"
            Height="8"
            VerticalAlignment="Stretch"
            Background="{DynamicResource TwainBorderSubtleBrush}"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext" />

        <!-- Article list / editor / alerts -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="260,8,*,8,240">

            <ItemsControl
                Grid.Column="0"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding LeftPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <ItemsControl
                Grid.Column="2"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding BottomPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

<!--
Article alerts for the currently processed article.
-->

<Border
    Grid.Column="4"
    BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
    BorderThickness="1"
    CornerRadius="4">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            Padding="12,10"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TwainTextPrimaryBrush}"
                    Text="Article Alerts" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    Text="{Binding Options.Alerts.Count}" />

            </Grid>

        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                Margin="8"
                ItemsSource="{Binding Options.Alerts}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,6"
                            Padding="10"
                            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock
                                Text="{Binding}"
                                TextWrapping="Wrap" />

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Border>

        </Grid>

    </Grid>

    <!--
    Workspace status bar.
    -->

    <Border
        Grid.Row="1"
        Grid.Column="2"
        Padding="12,6"
        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
        BorderThickness="0,1,0,0">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Ready" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="20">

                <TextBlock Text="Articles: 0" />
                <TextBlock Text="Processing: 0" />
                <TextBlock Text="Completed: 0" />
                <TextBlock Text="Skipped: 0" />
                <TextBlock Text="Errors: 0" />

            </StackPanel>

        </Grid>

    </Border>

</Grid>

</UserControl>