<UserControl
    x:Class="Twain.UI.Views.Workspaces.WorkspaceView"
    x:Name="WorkspaceRoot"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    xmlns:preview="using:Twain.UI.Preview"
    xmlns:workspaceControls="using:Twain.UI.Controls.Workspaces"
    xmlns:optionsViews="using:Twain.UI.Options"
    xmlns:profiles="using:Twain.UI.Profiles"
    xmlns:preferences="using:Twain.UI.Preferences"
    xmlns:botSettings="using:Twain.UI.BotSettings"
    xmlns:customModules="clr-namespace:Twain.CustomModules;assembly=Twain.CustomModules"
    x:DataType="vm:WorkspaceViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
        Hosts each workspace pane through the shared pane presentation control.
        -->
        <DataTemplate
            x:Key="WorkspacePaneTemplate"
            x:DataType="vm:PaneViewModel">

            <workspaceControls:WorkspacePaneHost />

        </DataTemplate>

    </UserControl.Resources>

<Grid
    x:Name="WorkspaceLayoutGrid"
    Background="{DynamicResource TwainWorkspaceBackgroundBrush}"
    RowDefinitions="*,Auto">

    <!-- Navigation width is controlled by WorkspaceView.axaml.cs. -->
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>


<!-- Left navigation -->

<Border
    x:Name="NavigationBorder"
    Grid.Row="0"
    Grid.RowSpan="2"
    Grid.Column="0"
    Padding="12"
    BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
    BorderThickness="0,0,1,0">


    <Border.Styles>

        <!-- Standard navigation buttons -->
        <Style Selector="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- Selectable navigation buttons -->
        <Style Selector="ToggleButton">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Hover: subtle surface highlight -->
        <Style Selector="ToggleButton:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource TwainSurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TwainBorderBrush}" />
        </Style>

        <!-- Pressed: stronger accent -->
        <Style Selector="ToggleButton:pressed">
            <Setter Property="Background"
                    Value="{DynamicResource TwainSelectionBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TwainAccentPressedBrush}" />
        </Style>

        <!-- Selected: persistent navigation highlight -->
        <Style Selector="ToggleButton:checked">
            <Setter Property="Background"
                    Value="{DynamicResource TwainSelectionBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TwainAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Selected and hovered: preserve selection -->
        <Style Selector="ToggleButton:checked:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource TwainSelectionBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource TwainAccentHoverBrush}" />
        </Style>

        <!-- Shared navigation icons -->
        <Style Selector="PathIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Border.Styles>


    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <StackPanel Spacing="6">

            <!-- Keep the toggle accessible in both navigation states. -->
            <Button
                Command="{Binding ToggleNavigationCommand}"
                ToolTip.Tip="Collapse or expand navigation"
                HorizontalContentAlignment="Center"
                HorizontalAlignment="Stretch">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon
                        IsVisible="{Binding IsNavigationExpanded}"
                        Data="M 3,4 L 21,4 L 21,20 L 3,20 Z M 9,4 L 9,20 M 7,10 L 4,12 L 7,14" />
                    <PathIcon
                        IsVisible="{Binding IsNavigationCollapsed}"
                        Data="M 3,4 L 21,4 L 21,20 L 3,20 Z M 9,4 L 9,20 M 5,10 L 8,12 L 5,14" />
                    <TextBlock
                        IsVisible="{Binding IsNavigationExpanded}"
                        VerticalAlignment="Center"
                        Text="Collapse navigation" />
                </StackPanel>
            </Button>


            <TextBlock IsVisible="{Binding IsNavigationExpanded}"
                Margin="4,4,4,12"
                FontSize="{DynamicResource TwainFontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                Text="Twain" />

            <!-- Editing Options -->

            <TextBlock IsVisible="{Binding IsNavigationExpanded}"
                Margin="4,4,4,6"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                Text="Editing Options" />

            <ToggleButton Command="{Binding ShowEditingCommand}"
                ToolTip.Tip="Editing View" IsChecked="{Binding IsEditingSelected, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,4 L 20,4 L 20,20 L 4,20 Z M 8,8 L 16,8 M 8,12 L 16,12 M 8,16 L 13,16" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Editing View" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Command="{Binding ShowOptionsCommand}"
                ToolTip.Tip="Options" IsChecked="{Binding IsOptionsVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,6 L 20,6 M 4,12 L 20,12 M 4,18 L 20,18 M 9,3 L 9,9 M 15,9 L 15,15 M 9,15 L 9,21" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Options" />
                </StackPanel>
            </ToggleButton>

            <Separator IsVisible="{Binding IsNavigationExpanded}" Margin="0,8" />

            <!-- User Settings -->

            <TextBlock IsVisible="{Binding IsNavigationExpanded}"
                Margin="4,0,4,6"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                Text="User Settings" />

            <ToggleButton Click="ProfilesButton_Click"
                ToolTip.Tip="Profiles" IsChecked="{Binding IsProfilesVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 12,3 A 4,4 0 1 1 12,11 A 4,4 0 1 1 12,3 M 4,21 L 4,18 C 4,13 20,13 20,18 L 20,21 Z" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Profiles" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Click="PreferencesButton_Click"
                ToolTip.Tip="Preferences" IsChecked="{Binding IsPreferencesVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 12,3 L 14,6 L 18,5 L 19,9 L 22,12 L 19,15 L 18,19 L 14,18 L 12,21 L 10,18 L 6,19 L 5,15 L 2,12 L 5,9 L 6,5 L 10,6 Z M 12,9 A 3,3 0 1 1 12,15 A 3,3 0 1 1 12,9" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Preferences" />
                </StackPanel>
            </ToggleButton>

            <ToggleButton Click="BotSettingsButton_Click"
                ToolTip.Tip="Bot settings" IsChecked="{Binding IsBotSettingsVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 5,7 L 19,7 L 19,19 L 5,19 Z M 12,3 L 12,7 M 8,11 L 10,11 L 10,13 L 8,13 Z M 14,11 L 16,11 L 16,13 L 14,13 Z M 9,16 L 15,16" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Bot settings" />
                </StackPanel>
            </ToggleButton>

            <Button Click="OpenSettingsButton_Click" ToolTip.Tip="Open settings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,3 L 15,3 L 20,8 L 20,21 L 4,21 Z M 14,3 L 14,9 L 20,9 M 8,14 L 16,14 M 8,18 L 16,18" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Open settings" />
                </StackPanel>
            </Button>

            <Button Click="SaveSettingsButton_Click" ToolTip.Tip="Save settings">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,3 L 18,3 L 21,6 L 21,21 L 3,21 L 3,3 Z M 7,3 L 7,10 L 17,10 L 17,3 M 7,21 L 7,13 L 17,13 L 17,21" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Save settings" />
                </StackPanel>
            </Button>

            <Button Click="SaveSettingsAsButton_Click" ToolTip.Tip="Save settings as...">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 3,3 L 18,3 L 21,6 L 21,21 L 3,21 Z M 7,3 L 7,10 L 17,10 L 17,3 M 7,21 L 7,13 L 17,13 L 17,21 M 16,12 L 22,18" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Save settings as..." />
                </StackPanel>
            </Button>

            <Separator IsVisible="{Binding IsNavigationExpanded}" Margin="0,8" />

            <!-- Tools -->

            <TextBlock IsVisible="{Binding IsNavigationExpanded}"
                Margin="4,0,4,6"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextSecondaryBrush}"
                Text="Tools" />

            <ToggleButton Click="CustomModulesButton_Click"
                ToolTip.Tip="Custom Modules" IsChecked="{Binding IsCustomModulesVisible, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 8,5 L 3,12 L 8,19 M 16,5 L 21,12 L 16,19 M 14,3 L 10,21" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Custom Modules" />
                </StackPanel>
            </ToggleButton>

            <Button Click="ListComparerButton_Click" ToolTip.Tip="List Comparer">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 3,4 L 10,4 L 10,20 L 3,20 Z M 14,4 L 21,4 L 21,20 L 14,20 Z M 5,9 L 8,9 M 16,9 L 19,9 M 5,14 L 8,14 M 16,14 L 19,14" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="List Comparer" />
                </StackPanel>
            </Button>

            <Button Click="ListSplitterButton_Click" ToolTip.Tip="List Splitter">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,3 L 20,3 L 20,21 L 4,21 Z M 7,8 L 17,8 M 12,8 L 12,18 M 7,18 L 17,18" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="List Splitter" />
                </StackPanel>
            </Button>

            <Button Click="DatabaseScannerButton_Click" ToolTip.Tip="Database Scanner">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,5 C 4,2 20,2 20,5 L 20,19 C 20,22 4,22 4,19 Z M 4,5 C 4,9 20,9 20,5 M 4,12 C 4,16 20,16 20,12" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Database Scanner" />
                </StackPanel>
            </Button>

            <Button Click="ExternalProcessingButton_Click" ToolTip.Tip="External Processing">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 4,5 L 14,5 L 14,9 M 4,19 L 14,19 L 14,15 M 11,12 L 21,12 M 17,8 L 21,12 L 17,16" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="External Processing" />
                </StackPanel>
            </Button>

            <Button Click="RegexTesterButton_Click" ToolTip.Tip="Regex Tester">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 5,5 L 19,5 L 19,19 L 5,19 Z M 8,10 L 11,13 L 8,16 M 13,16 L 17,16" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Regex Tester" />
                </StackPanel>
            </Button>

            <Separator IsVisible="{Binding IsNavigationExpanded}" Margin="0,8" />

            <!-- Application -->

            <Button Click="AboutButton_Click" ToolTip.Tip="About">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 12,2 A 10,10 0 1 1 12,22 A 10,10 0 1 1 12,2 M 12,10 L 12,17 M 12,6 L 12,8" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="About" />
                </StackPanel>
            </Button>

            <Button Click="ExitButton_Click" ToolTip.Tip="Exit">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <PathIcon Data="M 10,4 L 4,4 L 4,20 L 10,20 M 13,7 L 19,12 L 13,17 M 8,12 L 19,12" />
                    <TextBlock IsVisible="{Binding IsNavigationExpanded}" VerticalAlignment="Center" Text="Exit" />
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Border>


    <!-- Fixed separator between navigation and workspace. -->

    <Border
        Grid.Row="0"
        Grid.RowSpan="2"
        Grid.Column="1"
        Background="{DynamicResource TwainBorderSubtleBrush}" />

    <!-- Options and editing share the workspace without changing its internal panes. -->
    <Grid x:Name="OptionsSidebarGrid"
          Grid.Row="0"
          Grid.Column="2"
          ColumnDefinitions="0,0,*">

        <Border Grid.Column="0"
                Margin="12,0,0,8"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="{Binding IsOptionsVisible}">
            <optionsViews:OptionsView
                DataContext="{Binding Options}" />
        </Border>

        <GridSplitter Grid.Column="1"
                      Width="8"
                      HorizontalAlignment="Stretch"
                      Background="{DynamicResource TwainBorderSubtleBrush}"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      IsVisible="{Binding IsOptionsVisible}" />

    <!--
    Editing workspace.

    Diff occupies the entire upper region.
    Article List, Monaco, and Article Alerts occupy the lower region.
    -->

        <Grid
            Grid.Row="0"
            Grid.Column="2"
            Margin="0,0,12,8"
            RowDefinitions="*,8,*"
            IsVisible="{Binding IsEditingVisible}">

        <!-- Shared Diff / Preview output region -->

        <Grid Grid.Row="0">

            <!-- Existing Diff viewer -->

            <ItemsControl
                Grid.Row="1"
                IsVisible="{Binding IsDiffVisible}"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding DocumentPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <!-- Rendered MediaWiki preview -->

            <preview:PreviewView
                Grid.Row="1"
                IsVisible="{Binding IsPreviewVisible}" />

        </Grid>


        <GridSplitter
            Grid.Row="1"
            Height="8"
            VerticalAlignment="Stretch"
            Background="{DynamicResource TwainBorderSubtleBrush}"
            ResizeDirection="Rows"
            ResizeBehavior="PreviousAndNext" />

        <!-- Article list / editor / alerts -->

        <Grid
            Grid.Row="2"
            ColumnDefinitions="260,8,*,8,240">

            <ItemsControl
                Grid.Column="0"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding LeftPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <ItemsControl
                Grid.Column="2"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding BottomPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

<!--
Article alerts for the currently processed article.
-->

<Border
    Grid.Column="4"
    BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
    BorderThickness="1"
    CornerRadius="4">

    <Grid RowDefinitions="Auto,*">

        <Border
            Grid.Row="0"
            Padding="12,10"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TwainTextPrimaryBrush}"
                    Text="Article Alerts" />

                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    Text="{Binding Options.Alerts.Count}" />

            </Grid>

        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">

            <ItemsControl
                Margin="8"
                ItemsSource="{Binding Options.Alerts}">

                <ItemsControl.ItemTemplate>

                    <DataTemplate>

                        <Border
                            Margin="0,0,0,6"
                            Padding="10"
                            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="4">

                            <TextBlock
                                Text="{Binding}"
                                TextWrapping="Wrap" />

                        </Border>

                    </DataTemplate>

                </ItemsControl.ItemTemplate>

            </ItemsControl>

        </ScrollViewer>

    </Grid>

</Border>

        </Grid>

    </Grid>

    </Grid>

    <!-- Processing Profiles workspace. -->
    <profiles:ProfilesWindow
        x:Name="ProfilesView"
        Grid.Row="0"
        Grid.Column="2"
        Margin="12,0,12,8"
        IsVisible="{Binding IsProfilesVisible}" />

    <!-- Processing Preferences workspace. -->
    <preferences:PreferencesWindow
        x:Name="PreferencesView"
        Grid.Row="0"
        Grid.Column="2"
        Margin="12,0,12,8"
        IsVisible="{Binding IsPreferencesVisible}" />

    <!-- Processing Bot Settings workspace. -->
    <botSettings:BotSettingsWindow
        x:Name="BotSettingsView"
        Grid.Row="0"
        Grid.Column="2"
        Margin="12,0,12,8"
        IsVisible="{Binding #WorkspaceRoot.DataContext.IsBotSettingsVisible}" />

    <ContentControl
        x:Name="CustomModulesHost"
        Grid.Row="0"
        Grid.Column="2"
        Margin="12,0,12,8"
        IsVisible="{Binding #WorkspaceRoot.DataContext.IsCustomModulesVisible}" />

    <!--
    Workspace status bar.
    -->

    <Border
        Grid.Row="1"
        Grid.Column="2"
        Padding="12,6"
        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
        BorderThickness="0,1,0,0">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Ready" />

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                Spacing="20">

                <TextBlock Text="Articles: 0" />
                <TextBlock Text="Processing: 0" />
                <TextBlock Text="Completed: 0" />
                <TextBlock Text="Skipped: 0" />
                <TextBlock Text="Errors: 0" />

            </StackPanel>

        </Grid>

    </Border>

</Grid>

</UserControl>