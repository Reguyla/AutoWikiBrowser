<UserControl
    x:Class="Twain.UI.Views.Workspaces.WorkspaceView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    xmlns:workspaceControls="using:Twain.UI.Controls.Workspaces"
    x:DataType="vm:WorkspaceViewModel"
    d:DesignWidth="1100"
    d:DesignHeight="700"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--
        Hosts each workspace pane through the shared pane presentation control.
        -->
        <DataTemplate
            x:Key="WorkspacePaneTemplate"
            x:DataType="vm:PaneViewModel">

            <workspaceControls:WorkspacePaneHost />

        </DataTemplate>

    </UserControl.Resources>

    <Grid
        Margin="{DynamicResource TwainWorkspacePadding}"
        Background="{DynamicResource TwainWorkspaceBackgroundBrush}"
        RowDefinitions="Auto,*">

        <!-- Workspace heading and temporary pane-restoration command. -->

        <StackPanel
            Grid.Row="0"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingMedium}">

            <TextBlock
                VerticalAlignment="Center"
                FontSize="{DynamicResource TwainFontSizeLarge}"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                Text="Workspace" />

            <Button
                MinHeight="{DynamicResource TwainControlHeight}"
                Padding="{DynamicResource TwainControlPadding}"
                Command="{Binding ShowAllPanesCommand}"
                Content="Show all panes" />

        </StackPanel>

        <!--
        Initial built-in editing workspace.

        The diff occupies the primary workspace above the configuration
        and editing panes.

        The lower region contains Make List, Options, and the Article Editor.
        -->

        <Grid
            Grid.Row="1"
            ColumnDefinitions="260,8,300,8,*"
            RowDefinitions="2*,8,*">

            <!--
            Upper document region: diff and comparison output.
            -->

            <ItemsControl
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding DocumentPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <!--
            Horizontal splitter between the diff and the lower workspace.
            -->

            <GridSplitter
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="5"
                Height="8"
                VerticalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Rows"
                ResizeBehavior="PreviousAndNext" />

            <!--
            Lower-left region: article navigation and queue-related panes.
            -->

            <ItemsControl
                Grid.Row="2"
                Grid.Column="0"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding LeftPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Row="2"
                Grid.Column="1"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <!--
            Lower-center region: options and job configuration.
            -->

            <ItemsControl
                Grid.Row="2"
                Grid.Column="2"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding CenterPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

            <GridSplitter
                Grid.Row="2"
                Grid.Column="3"
                Width="8"
                HorizontalAlignment="Stretch"
                Background="{DynamicResource TwainBorderSubtleBrush}"
                ResizeDirection="Columns"
                ResizeBehavior="PreviousAndNext" />

            <!--
            Lower-right region: article editor.
            -->

            <ItemsControl
                Grid.Row="2"
                Grid.Column="4"
                ItemTemplate="{StaticResource WorkspacePaneTemplate}"
                ItemsSource="{Binding BottomPanes}">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

            </ItemsControl>

        </Grid>

    </Grid>

</UserControl>