
<UserControl
    x:Class="Twain.UI.Controls.Workspaces.WorkspacePaneHost"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Workspaces"
    xmlns:listControls="using:Twain.UI.Controls.Lists"
    xmlns:listViewModels="using:Twain.UI.ViewModels.Lists"
    x:DataType="vm:PaneViewModel"
    d:DesignWidth="400"
    d:DesignHeight="300"
    mc:Ignorable="d">

    <!-- Shared workspace pane frame -->
    <Border
        Background="{DynamicResource TwainSurfaceBrush}"
        BorderBrush="{DynamicResource TwainBorderBrush}"
        BorderThickness="{DynamicResource TwainBorderThickness}"
        CornerRadius="{DynamicResource TwainPaneCornerRadius}"
        IsVisible="{Binding IsVisible}">

        <Grid RowDefinitions="Auto,*">

        <!-- Shared pane title bar -->
        <Border
            Grid.Row="0"
            MinHeight="{DynamicResource TwainPaneHeaderHeight}"
            Padding="12,6"
            Background="{DynamicResource TwainSelectionBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,0,0,1">

            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto"
                  ColumnSpacing="8">

                <!-- Pane title -->
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource TwainFontSizeMedium}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TwainTextPrimaryBrush}"
                    Text="{Binding Title}" />
                
                <!-- Last article revision -->
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="{DynamicResource TwainFontSizeSmall}"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    Text="{Binding LastEditTimestamp}"
                    IsVisible="{Binding HasLastEditTimestamp}"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="220" />
 
                <!-- Article revision history -->
                <Button
                    Grid.Column="2"
                    Classes="twain-pane-header-button"
                    Command="{Binding OpenHistoryCommand}"
                    IsVisible="{Binding HasHistoryAction}"
                    ToolTip.Tip="Open article revision history"
                    Padding="10,2"
                    MinWidth="65"
                    HorizontalAlignment="Center">

                    <TextBlock
                        Text="History"
                        TextDecorations="Underline"
                        TextWrapping="NoWrap"
                        FontSize="{DynamicResource TwainFontSizeSmall}"
                        Foreground="{DynamicResource TwainTextPrimaryBrush}" />

                </Button>

                <!-- Edit article on wiki -->
                <Button
                    Grid.Column="3"
                    Classes="twain-pane-header-button"
                    Command="{Binding EditOnWikiCommand}"
                    IsVisible="{Binding HasEditOnWikiAction}"
                    ToolTip.Tip="Edit article on wiki"
                    Padding="4,2">

                    <PathIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource TwainTextPrimaryBrush}"
                        Data="M 12,20 H 21 M 16.5,3.5 A 2.121,2.121 0 0 1 19.5,6.5 L 7,19 L 3,21 L 5,17 Z" />

                </Button>

                <!-- Article watchlist status -->
                <Grid Grid.Column="4"
                      IsVisible="{Binding HasWatchlistStatus}">

                    <!-- Watched article: filled star -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        IsVisible="{Binding IsArticleWatched}"
                        Foreground="{DynamicResource TwainTextPrimaryBrush}"
                        ToolTip.Tip="{Binding WatchlistToolTip}"
                        Data="M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z" />

                    <!-- Unwatched article: outlined star -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        IsVisible="{Binding !IsArticleWatched}"
                        Foreground="{DynamicResource TwainTextPrimaryBrush}"
                        ToolTip.Tip="{Binding WatchlistToolTip}"
                        Data="M12 2 L15.09 8.26 L22 9.27 L17 14.14 L18.18 21.02 L12 17.77 L5.82 21.02 L7 14.14 L2 9.27 L8.91 8.26 Z M12 4.8 L9.84 9.17 L5.02 9.87 L8.51 13.27 L7.69 18.07 L12 15.8 L16.31 18.07 L15.49 13.27 L18.98 9.87 L14.16 9.17 Z" />

                </Grid>

                <!-- Optional pane status indicator -->
                <TextBlock
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    FontSize="{DynamicResource TwainFontSizeSmall}"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}"
                    Text="{Binding HeaderStatusText}"
                    IsVisible="{Binding HasHeaderStatus}"
                    TextTrimming="CharacterEllipsis"
                    MaxWidth="140" />

                <!-- Optional pane header action -->
                <Button
                    Grid.Column="6"
                    Classes="twain-pane-header-button"
                    IsVisible="{Binding HasHeaderAction}"
                    Command="{Binding ExecuteHeaderActionCommand}"
                    ToolTip.Tip="{Binding HeaderActionToolTip}">

                    <Grid Width="16" Height="16">

                    <!-- Settings icon -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        IsVisible="{Binding ShowSettingsHeaderIcon}"
                        Data="M 12,3 L 14,6 L 18,5 L 19,9 L 22,12 L 19,15 L 18,19 L 14,18 L 12,21 L 10,18 L 6,19 L 5,15 L 2,12 L 5,9 L 6,5 L 10,6 Z M 12,9 A 3,3 0 1 1 12,15 A 3,3 0 1 1 12,9" />

                    <!-- Filter icon -->
                    <PathIcon
                        Width="16"
                        Height="16"
                        IsVisible="{Binding ShowFilterHeaderIcon}"
                        Data="M3,4 H21 L14,12 V20 L10,22 V12 Z" />

                    </Grid>
                </Button>

            </Grid>

        </Border>

            <!--
                Pane-specific content host.

                Do not add margins, padding, or clipping here.
                NativeWebView and Monaco require the full
                available content area.
            -->
            <Border
                Grid.Row="1"
                MinHeight="0"
                Background="{DynamicResource TwainRaisedSurfaceBrush}"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="0">

                <ContentControl
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    Content="{Binding Content}">

                    <ContentControl.DataTemplates>

                        <!-- Make List pane -->
                        <DataTemplate
                            DataType="listViewModels:MakeListViewModel">

                            <listControls:MakeListControl />

                        </DataTemplate>

                    </ContentControl.DataTemplates>

                </ContentControl>

            </Border>

        </Grid>

    </Border>

</UserControl>
