
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.ErrorHandling.ErrorMessageWindow"
    Width="520"
    Height="220"
    MinWidth="420"
    MinHeight="180"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Error message -->
        <TextBlock
            x:Name="MessageTextBlock"
            Grid.Row="0"
            TextWrapping="Wrap"
            VerticalAlignment="Center" />

        <!-- Acknowledgment -->
        <Button
            Grid.Row="1"
            Classes="twain-command-button"
            HorizontalAlignment="Right"
            Content="OK"
            Click="OkButton_Click" />

    </Grid>
</Window>
