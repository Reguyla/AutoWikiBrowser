
<UserControl
    x:Class="Twain.UI.Controls.EditProtectControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        RowDefinitions="Auto,Auto"
        ColumnDefinitions="*,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
        RowSpacing="{DynamicResource TwainSpacingSmall}">

        <!-- Create/Edit protection -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Classes="twain-section-heading"
                Text="Create/Edit" />

            <ListBox
                Name="EditProtectionListBox"
                Height="70"
                SelectionChanged="EditProtectionListBox_SelectionChanged" />
        </StackPanel>

        <!-- Move protection -->
        <StackPanel
            Grid.Row="0"
            Grid.Column="1"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Classes="twain-section-heading"
                Text="Move" />

            <ListBox
                Name="MoveProtectionListBox"
                Height="70"
                IsEnabled="False"
                SelectionChanged="MoveProtectionListBox_SelectionChanged" />
        </StackPanel>

        <!-- Move permissions -->
        <CheckBox
            Grid.Row="1"
            Grid.Column="1"
            Name="UnlockMoveCheckBox"
            Content="Unlock move permissions"
            IsCheckedChanged="UnlockMoveCheckBox_IsCheckedChanged" />

    </Grid>
</UserControl>
