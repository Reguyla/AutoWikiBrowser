
<UserControl
    x:Class="Twain.UI.Controls.EditProtectControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border
        Padding="12"
        Background="{DynamicResource TwainSurfaceBrush}"
        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
        BorderThickness="1"
        CornerRadius="{DynamicResource TwainControlCornerRadius}">

        <Grid
            RowDefinitions="Auto,Auto"
            ColumnDefinitions="*,*"
            ColumnSpacing="{DynamicResource TwainSpacingMedium}"
            RowSpacing="{DynamicResource TwainSpacingMedium}">

            <!-- Create/Edit protection -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <TextBlock
                    Classes="twain-section-heading"
                    Text="Create/Edit" />

                <ListBox
                    x:Name="EditProtectionListBox"
                    Height="100"
                    SelectionChanged="EditProtectionListBox_SelectionChanged" />

            </StackPanel>

            <!-- Move protection -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <TextBlock
                    Classes="twain-section-heading"
                    Text="Move" />

                <ListBox
                    x:Name="MoveProtectionListBox"
                    Height="100"
                    IsEnabled="False"
                    SelectionChanged="MoveProtectionListBox_SelectionChanged" />

            </StackPanel>

            <!-- Move permissions -->
            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                x:Name="UnlockMoveCheckBox"
                Content="Unlock move permissions"
                IsCheckedChanged="UnlockMoveCheckBox_IsCheckedChanged" />

        </Grid>
    </Border>
</UserControl>
