
<Window
    x:Class="Twain.UI.Controls.LevelNumberWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    MinWidth="320"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Select number"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Prompt -->
        <TextBlock
            x:Name="PromptTextBlock"
            Grid.Row="0"
            Text="Number of levels:"
            Foreground="{DynamicResource TwainTextPrimaryBrush}"
            TextWrapping="Wrap" />

        <!-- Number selection -->
        <NumericUpDown
            x:Name="LevelNumericUpDown"
            Grid.Row="1"
            MinHeight="32"
            HorizontalAlignment="Stretch"
            Minimum="1"
            Maximum="1000"
            Value="1"
            Increment="1" />

        <!-- Commands -->
        <Border
            Grid.Row="2"
            Margin="0,4,0,0"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-primary-button"
                    Content="_OK"
                    IsDefault="True"
                    Click="OkButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="_Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />

            </StackPanel>
        </Border>

    </Grid>
</Window>
