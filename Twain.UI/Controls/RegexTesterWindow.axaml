
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Twain.UI.Controls.RegexTesterWindow"
    mc:Ignorable="d"
    d:DesignWidth="760"
    d:DesignHeight="640"
    Width="760"
    Height="640"
    MinWidth="600"
    MinHeight="500"
    WindowStartupLocation="CenterOwner"
    Title="Regex Tester"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <!-- Main window layout -->
    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Description -->
        <TextBlock
            Grid.Row="0"
            Text="Test regular expressions against sample text, inspect matches and capture groups, and preview replacements."
            TextWrapping="Wrap"
            Foreground="{DynamicResource TwainTextSecondaryBrush}"
            FontSize="{DynamicResource TwainFontSizeSmall}" />

        <!-- Find, Replace, and Regex Options -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            RowDefinitions="Auto,Auto"
            ColumnSpacing="{DynamicResource TwainSpacingMedium}"
            RowSpacing="{DynamicResource TwainSpacingMedium}">

            <!-- Find and Replace expressions -->
            <Grid
                Grid.Row="0"
                Grid.Column="0"
                RowDefinitions="Auto,Auto,Auto,Auto"
                RowSpacing="{DynamicResource TwainSpacingSmall}">

                <TextBlock
                    Grid.Row="0"
                    Text="Find:"
                    FontWeight="SemiBold" />

                <TextBox
                    x:Name="FindTextBox"
                    Grid.Row="1"
                    Height="72"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    TextChanged="ConditionsChanged"
                    ToolTip.Tip="The regular expression to find" />

                <TextBlock
                    Grid.Row="2"
                    Text="Replace:"
                    FontWeight="SemiBold"
                    Margin="0,4,0,0" />

                <TextBox
                    x:Name="ReplaceTextBox"
                    Grid.Row="3"
                    Height="72"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    TextChanged="ConditionsChanged"
                    ToolTip.Tip="The replacement expression" />

            </Grid>

            <!-- Regex options -->
            <Border
                Grid.Row="0"
                Grid.Column="1"
                Classes="twain-section"
                Margin="0"
                VerticalAlignment="Stretch">

                <StackPanel
                    Spacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock
                        Classes="twain-section-heading"
                        Text="Regex options" />

                    <Grid
                        ColumnDefinitions="Auto,Auto"
                        RowDefinitions="Auto,Auto"
                        ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                        RowSpacing="{DynamicResource TwainSpacingSmall}">

                        <CheckBox
                            x:Name="MultilineCheckBox"
                            Grid.Row="0"
                            Grid.Column="0"
                            Content="Multiline"
                            ToolTip.Tip="Changes ^ and $ so they match the beginning and end of each line." />

                        <CheckBox
                            x:Name="SinglelineCheckBox"
                            Grid.Row="0"
                            Grid.Column="1"
                            Content="Singleline"
                            ToolTip.Tip="Changes . so it matches every character, including newlines." />

                        <CheckBox
                            x:Name="IgnoreCaseCheckBox"
                            Grid.Row="1"
                            Grid.Column="0"
                            Content="Ignore case"
                            ToolTip.Tip="Performs case-insensitive matching." />

                        <CheckBox
                            x:Name="ExplicitCaptureCheckBox"
                            Grid.Row="1"
                            Grid.Column="1"
                            Content="Explicit capture"
                            ToolTip.Tip="Only named or explicitly numbered groups capture substrings." />

                    </Grid>
                </StackPanel>
            </Border>

            <!-- Regex commands -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    x:Name="FindButton"
                    Classes="twain-command-button"
                    Content="Find"
                    MinWidth="85"
                    IsEnabled="False"
                    Click="FindButton_Click" />

                <Button
                    x:Name="ReplaceButton"
                    Classes="twain-command-button"
                    Content="Replace"
                    MinWidth="85"
                    IsEnabled="False"
                    Click="ReplaceButton_Click" />

                <Button
                    x:Name="HelpButton"
                    Classes="twain-command-button"
                    Content="Help"
                    MinWidth="85"
                    Click="HelpButton_Click" />

            </StackPanel>

        </Grid>

        <!-- Input and output -->
        <Grid
            Grid.Row="2"
            RowDefinitions="*,Auto,*"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <!-- Input text -->
            <Grid
                Grid.Row="0"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Text="Text to&#10;search:" />

                <TextBox
                    x:Name="InputTextBox"
                    Grid.Column="1"
                    AcceptsReturn="True"
                    TextWrapping="NoWrap"
                    FontFamily="Consolas"
                    TextChanged="ConditionsChanged"
                    ToolTip.Tip="Enter or paste the text to be searched here" />

            </Grid>

            <!-- Resizable divider -->
            <GridSplitter
                Grid.Row="1"
                Height="6"
                HorizontalAlignment="Stretch"
                ResizeDirection="Rows" />

            <!-- Results -->
            <Grid
                Grid.Row="2"
                ColumnDefinitions="Auto,*"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Top"
                    Text="Result:" />

                <Grid Grid.Column="1">

                    <TreeView
                        x:Name="CapturesTreeView"
                        IsVisible="True"
                        ToolTip.Tip="Displays regular-expression matches and captures" />

                    <TextBox
                        x:Name="ResultTextBox"
                        IsVisible="False"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        FontFamily="Consolas" />

                </Grid>
            </Grid>

        </Grid>

        <!-- Status -->
        <Grid
            Grid.Row="3"
            ColumnDefinitions="Auto,*"
            ColumnSpacing="{DynamicResource TwainSpacingMedium}">

            <ProgressBar
                x:Name="ProgressBar"
                Width="100"
                Height="16"
                IsIndeterminate="False"
                IsVisible="False" />

            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center" />

        </Grid>

    </Grid>
</Window>
