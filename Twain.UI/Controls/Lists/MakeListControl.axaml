<UserControl
    x:Class="Twain.UI.Controls.Lists.MakeListControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Twain.UI.ViewModels.Lists"
    x:DataType="vm:MakeListViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto,Auto,*,Auto"
          RowSpacing="8">

        <!-- List source -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <ComboBox
                ItemsSource="{Binding Providers}"
                SelectedItem="{Binding SelectedProvider}"
                HorizontalAlignment="Stretch" />

            <Button
                Grid.Column="1"
                Content="Make List"
                IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Source input -->
        <TextBox
            Grid.Row="1"
            Text="{Binding SourceText}"
            Watermark="{Binding SourcePrompt}"
            IsEnabled="{Binding IsSourceTextEnabled}" />

        <!-- Article list -->
        <ListBox
            Grid.Row="2"
            ItemsSource="{Binding Articles}"
            SelectionMode="Multiple" />

        <!-- Manual article entry -->
        <Grid Grid.Row="3"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">

            <TextBox
                Text="{Binding ManualArticleTitle}"
                Watermark="Article title" />

            <Button
                Grid.Column="1"
                Content="Add"
                Command="{Binding AddArticleCommand}" />
        </Grid>
    </Grid>

</UserControl>