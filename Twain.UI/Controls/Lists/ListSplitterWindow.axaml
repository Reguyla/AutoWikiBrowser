
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:makeList="using:Twain.UI.Controls.Lists"
    x:Class="Twain.UI.Controls.Lists.ListSplitterWindow"
    mc:Ignorable="d"
    d:DesignWidth="700"
    d:DesignHeight="500"
    Width="700"
    Height="500"
    MinWidth="550"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Title="List splitter"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Article list -->
        <makeList:MakeListControl
            x:Name="ListMaker" />

        <!-- Split and save controls -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <Grid
                ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Pages per file:" />

                <NumericUpDown
                    x:Name="PagesPerFile"
                    Grid.Column="1"
                    Width="110"
                    Minimum="100"
                    Maximum="100000"
                    Increment="10"
                    Value="100" />

                <Button
                    x:Name="SaveTextButton"
                    Grid.Column="3"
                    Classes="twain-command-button"
                    Content="Save text files"
                    IsEnabled="False"
                    Click="SaveTextButton_Click" />

                <Button
                    x:Name="SaveSettingsButton"
                    Grid.Column="4"
                    Classes="twain-command-button"
                    Content="Save settings files"
                    IsEnabled="False"
                    Click="SaveSettingsButton_Click" />

            </Grid>
        </Border>

    </Grid>
</Window>
