
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:makeList="using:Twain.UI.Controls.Lists"
    x:Class="Twain.UI.Controls.Lists.ListSplitterWindow"
    mc:Ignorable="d"
    d:DesignWidth="700"
    d:DesignHeight="500"
    Width="700"
    Height="500"
    MinWidth="550"
    MinHeight="400"
    WindowStartupLocation="CenterOwner"
    Title="List splitter"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Article list and page count -->
        <Grid
            Grid.Row="0"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                x:Name="ArticleCountText"
                Grid.Row="0"
                Text="0 pages"
                Foreground="{DynamicResource TwainTextSecondaryBrush}" />

            <makeList:MakeListControl
                x:Name="ListMaker"
                Grid.Row="1" />

        </Grid>

        <!-- Split and save controls -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <Grid
                ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="Pages per file:" />

                <NumericUpDown
                    x:Name="PagesPerFile"
                    Grid.Column="1"
                    Width="110"
                    Minimum="100"
                    Maximum="100000"
                    Increment="10"
                    Value="100" />

                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Text="Save as:" />

                <ComboBox
                    x:Name="SaveFormatComboBox"
                    Grid.Column="4"
                    Width="180"
                    SelectedIndex="1">

                    <ComboBoxItem Content="Wiki text" />
                    <ComboBoxItem Content="Plain text" />
                    <ComboBoxItem Content="CSV" />
                    <ComboBoxItem Content="CSV with Wikitext" />
                    <ComboBoxItem Content="Twain settings (XML)" />

                </ComboBox>

                <Button
                    x:Name="SaveFilesButton"
                    Grid.Column="5"
                    Classes="twain-command-button"
                    Content="Save split files"
                    IsEnabled="False"
                    Click="SaveFilesButton_Click" />

            </Grid>
        </Border>

    </Grid>
</Window>
