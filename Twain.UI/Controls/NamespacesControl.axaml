
<UserControl
    x:Class="Twain.UI.Controls.NamespacesControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="280">

    <Grid
        ColumnDefinitions="*,*"
        ColumnSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Subject namespaces -->
        <Grid
            Grid.Column="0"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <CheckBox
                Name="SubjectCheckBox"
                Content="Subject"
                IsCheckedChanged="SubjectCheckBox_IsCheckedChanged" />

            <Border
                Grid.Row="1"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="{DynamicResource TwainBorderThickness}"
                CornerRadius="{DynamicResource TwainControlCornerRadius}"
                Background="{DynamicResource TwainControlBackgroundBrush}"
                Padding="4">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Name="SubjectPanel"
                        Spacing="0" />

                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Talk namespaces -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*"
            RowSpacing="{DynamicResource TwainSpacingSmall}">

            <CheckBox
                Name="TalkCheckBox"
                Content="Talk"
                IsCheckedChanged="TalkCheckBox_IsCheckedChanged" />

            <Border
                Grid.Row="1"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="{DynamicResource TwainBorderThickness}"
                CornerRadius="{DynamicResource TwainControlCornerRadius}"
                Background="{DynamicResource TwainControlBackgroundBrush}"
                Padding="4">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                    <StackPanel
                        Name="TalkPanel"
                        Spacing="0" />

                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</UserControl>
