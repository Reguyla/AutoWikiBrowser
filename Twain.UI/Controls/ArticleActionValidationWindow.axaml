
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.Controls.ArticleActionValidationWindow"
    Width="420"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Validation error"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Validation message -->
        <TextBlock
            x:Name="MessageTextBlock"
            TextWrapping="Wrap" />

        <!-- Commands -->
        <Button
            Grid.Row="1"
            Classes="twain-command-button"
            HorizontalAlignment="Right"
            Content="OK"
            Click="OkButton_Click" />

    </Grid>
</Window>
