
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Twain.UI.Controls.RegexApplyChangesWindow"
    Width="400"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Title="Regex Tester"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Confirmation message -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <TextBlock
                Text="Do you want to apply your changes?"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                TextWrapping="Wrap" />

        </Border>

        <!-- Commands -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-primary-button"
                    Content="Apply"
                    IsDefault="True"
                    Click="ApplyButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="Discard"
                    Click="DiscardButton_Click" />

                <Button
                    Classes="twain-command-button"
                    Content="Cancel"
                    IsCancel="True"
                    Click="CancelButton_Click" />

            </StackPanel>

        </Border>

    </Grid>
</Window>
