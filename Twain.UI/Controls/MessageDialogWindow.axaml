
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Twain.UI.Controls.MessageDialogWindow"
    mc:Ignorable="d"
    d:DesignWidth="420"
    d:DesignHeight="180"
    Width="420"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Dialog message -->
        <TextBlock
            x:Name="MessageTextBlock"
            TextWrapping="Wrap" />

        <!-- Commands -->
        <StackPanel
            x:Name="ButtonsPanel"
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                x:Name="YesButton"
                Classes="twain-primary-button"
                Content="Yes"
                IsVisible="False"
                Click="YesButton_Click" />

            <Button
                x:Name="NoButton"
                Classes="twain-command-button"
                Content="No"
                IsVisible="False"
                Click="NoButton_Click" />

            <Button
                x:Name="OkButton"
                Classes="twain-command-button"
                Content="OK"
                IsDefault="True"
                Click="OkButton_Click" />

        </StackPanel>
    </Grid>
</Window>
