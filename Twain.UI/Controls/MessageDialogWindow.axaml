
<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="Twain.UI.Controls.MessageDialogWindow"
    mc:Ignorable="d"
    d:DesignWidth="440"
    d:DesignHeight="180"
    Width="440"
    SizeToContent="Height"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Dialog message -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <TextBlock
                x:Name="MessageTextBlock"
                Foreground="{DynamicResource TwainTextPrimaryBrush}"
                TextWrapping="Wrap" />

        </Border>

        <!-- Dialog commands -->
        <Border
            Grid.Row="1"
            Padding="0,12,0,0"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="0,1,0,0">

            <StackPanel
                x:Name="ButtonsPanel"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    x:Name="YesButton"
                    Classes="twain-primary-button"
                    Content="Yes"
                    IsVisible="False"
                    Click="YesButton_Click" />

                <Button
                    x:Name="NoButton"
                    Classes="twain-command-button"
                    Content="No"
                    IsVisible="False"
                    Click="NoButton_Click" />

                <Button
                    x:Name="OkButton"
                    Classes="twain-command-button"
                    Content="OK"
                    IsDefault="True"
                    Click="OkButton_Click" />

            </StackPanel>

        </Border>

    </Grid>
</Window>
