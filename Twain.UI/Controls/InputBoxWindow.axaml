
<Window
    x:Class="Twain.UI.Controls.InputBoxWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="500"
    Height="180"
    MinWidth="420"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="Input"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Prompt -->
        <TextBlock
            x:Name="PromptTextBlock"
            Grid.Row="0"
            TextWrapping="Wrap" />

        <!-- User input -->
        <TextBox
            x:Name="InputTextBox"
            Grid.Row="1"
            TextChanged="InputTextBox_TextChanged" />

        <!-- Validation message -->
        <TextBlock
            x:Name="ValidationTextBlock"
            Grid.Row="2"
            IsVisible="False"
            TextWrapping="Wrap" />

        <!-- Commands -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <Button
                Classes="twain-primary-button"
                Content="_OK"
                IsDefault="True"
                Click="OkButton_Click" />

            <Button
                Classes="twain-command-button"
                Content="_Cancel"
                IsCancel="True"
                Click="CancelButton_Click" />

        </StackPanel>
    </Grid>
</Window>
