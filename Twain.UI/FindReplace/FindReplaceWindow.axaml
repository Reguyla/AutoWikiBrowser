
<Window
    x:Class="Twain.UI.FindReplace.FindReplaceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Twain.UI.FindReplace"
    x:DataType="vm:FindReplaceViewModel"
    Title="Find and Replace"
    Width="1000"
    Height="650"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Heading -->
        <TextBlock
            Grid.Row="0"
            Classes="twain-section-heading"
            Text="Find and Replace" />

        <!-- Find and replace options -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingLarge}">

            <CheckBox
                Content="Ignore links"
                IsChecked="{Binding IgnoreLinks, Mode=TwoWay}"
                IsEnabled="{Binding CanChangeIgnoreLinks}" />

            <CheckBox
                Content="Ignore more"
                IsChecked="{Binding IgnoreMore, Mode=TwoWay}" />

            <CheckBox
                Content="Append to summary"
                IsChecked="{Binding AppendToSummary, Mode=TwoWay}" />

        </StackPanel>

        <!-- Search -->
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBox
                Width="250"
                Watermark="Search Find and Replace"
                Text="{Binding SearchText, Mode=TwoWay}" />

            <Button
                Classes="twain-command-button"
                Command="{Binding SearchCommand}"
                Content="Search" />

        </StackPanel>

        <!-- Replacement rules -->
        <DataGrid
            Grid.Row="3"
            Classes="twain-datagrid"
            ItemsSource="{ReflectionBinding Rows}"
            SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
            AutoGenerateColumns="False"
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="False"
            GridLinesVisibility="All"
            IsReadOnly="False">

            <DataGrid.ContextMenu>
                <ContextMenu>

                    <MenuItem Header="Enabled">
                        <MenuItem
                            Header="Enable all"
                            Command="{Binding EnableAllCommand}" />
                        <MenuItem
                            Header="Disable all"
                            Command="{Binding DisableAllCommand}" />
                    </MenuItem>

                    <MenuItem Header="Regular expressions">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllRegexCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllRegexCommand}" />
                    </MenuItem>

                    <MenuItem Header="Case sensitive">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllCaseSensitiveCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllCaseSensitiveCommand}" />
                    </MenuItem>

                    <MenuItem Header="Multiline">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllMultilineCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllMultilineCommand}" />
                    </MenuItem>

                    <MenuItem Header="Singleline">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllSinglelineCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllSinglelineCommand}" />
                    </MenuItem>

                    <MenuItem Header="Minor">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllMinorCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllMinorCommand}" />
                    </MenuItem>

                    <MenuItem Header="After processing">
                        <MenuItem
                            Header="Check all"
                            Command="{Binding CheckAllAfterCommand}" />
                        <MenuItem
                            Header="Uncheck all"
                            Command="{Binding UncheckAllAfterCommand}" />
                    </MenuItem>

                </ContextMenu>
            </DataGrid.ContextMenu>

            <DataGrid.Columns>

                <DataGridTextColumn
                    Header="Find"
                    Width="*"
                    Binding="{ReflectionBinding Find, Mode=TwoWay}" />

                <DataGridTextColumn
                    Header="Replace"
                    Width="*"
                    Binding="{ReflectionBinding Replace, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Enabled"
                    Binding="{ReflectionBinding Enabled, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Regex"
                    Binding="{ReflectionBinding IsRegex, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Case sensitive"
                    Binding="{ReflectionBinding CaseSensitive, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Multiline"
                    Binding="{ReflectionBinding Multiline, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Singleline"
                    Binding="{ReflectionBinding Singleline, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Minor"
                    Binding="{ReflectionBinding Minor, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="After"
                    Binding="{ReflectionBinding BeforeOrAfter, Mode=TwoWay}" />

                <DataGridTextColumn
                    Header="Comment"
                    Width="200"
                    Binding="{ReflectionBinding Comment, Mode=TwoWay}" />

            </DataGrid.Columns>

        </DataGrid>


        <!-- Rule management and completion commands -->
        <Grid
            Grid.Row="4"
            RowDefinitions="Auto,Auto"
            RowSpacing="{DynamicResource TwainSpacingMedium}">

            <!-- Rule management -->
            <WrapPanel
                Grid.Row="0"
                HorizontalAlignment="Center"
                Orientation="Horizontal"
                ItemSpacing="{DynamicResource TwainSpacingSmall}"
                LineSpacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-command-button"
                    Command="{Binding AddRuleCommand}"
                    Content="Add rule" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding RemoveRuleCommand}"
                    Content="Remove rule" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding MoveRuleUpCommand}"
                    Content="Move up" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding MoveRuleDownCommand}"
                    Content="Move down" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding MoveRuleToTopCommand}"
                    Content="Move to top" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding MoveRuleToBottomCommand}"
                    Content="Move to bottom" />

                <Button
                    Classes="twain-command-button"
                    Command="{Binding ClearRulesCommand}"
                    Content="Clear all" />

            </WrapPanel>

            <!-- Completion commands -->
            <StackPanel
                Grid.Row="1"
                HorizontalAlignment="Right"
                Orientation="Horizontal"
                Spacing="{DynamicResource TwainSpacingSmall}">

                <Button
                    Classes="twain-command-button"
                    Content="Cancel" />

                <Button
                    Classes="twain-primary-button"
                    Content="OK" />

            </StackPanel>

        </Grid>

    </Grid>
</Window>

