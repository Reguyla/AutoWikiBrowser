<Window
    x:Class="Twain.UI.FindReplace.FindReplaceWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Twain.UI.FindReplace"
    x:DataType="vm:FindReplaceViewModel"
    Title="Find and Replace"
    Width="1000"
    Height="650"
    MinWidth="800"
    MinHeight="500"
    WindowStartupLocation="CenterOwner">

        <Grid RowDefinitions="Auto,Auto,*,Auto"
              Margin="12">

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,12"
            FontSize="18"
            FontWeight="SemiBold"
            Text="Find and Replace" />

        <StackPanel
            Grid.Row="1"
            Margin="0,0,0,12"
            Orientation="Horizontal"
            Spacing="16">

            <CheckBox
                Content="Ignore links"
                IsChecked="{Binding IgnoreLinks, Mode=TwoWay}"
                IsEnabled="{Binding CanChangeIgnoreLinks}" />

            <CheckBox
                Content="Ignore more"
                IsChecked="{Binding IgnoreMore, Mode=TwoWay}" />

            <CheckBox
                Content="Append to summary"
                IsChecked="{Binding AppendToSummary, Mode=TwoWay}" />

        </StackPanel>

            <DataGrid
                Grid.Row="2"
                ItemsSource="{ReflectionBinding Rows}"
                SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                CanUserSortColumns="False"
                GridLinesVisibility="All">

            <DataGrid.Columns>
                <DataGridTextColumn
                    Header="Find"
                    Width="*"
                    Binding="{ReflectionBinding Find, Mode=TwoWay}" />

                <DataGridTextColumn
                    Header="Replace"
                    Width="*"
                    Binding="{ReflectionBinding Replace, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Enabled"
                    Binding="{ReflectionBinding Enabled, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Regex"
                    Binding="{ReflectionBinding IsRegex, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Case sensitive"
                    Binding="{ReflectionBinding CaseSensitive, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Multiline"
                    Binding="{ReflectionBinding Multiline, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Singleline"
                    Binding="{ReflectionBinding Singleline, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="Minor"
                    Binding="{ReflectionBinding Minor, Mode=TwoWay}" />

                <DataGridCheckBoxColumn
                    Header="After"
                    Binding="{ReflectionBinding BeforeOrAfter, Mode=TwoWay}" />

                <DataGridTextColumn
                    Header="Comment"
                    Width="200"
                    Binding="{ReflectionBinding Comment, Mode=TwoWay}" />
            </DataGrid.Columns>

        </DataGrid>

        <StackPanel
            Grid.Row="3"
            Margin="0,12,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">

            <Button
                MinWidth="90"
                Command="{Binding AddRuleCommand}"
                Content="Add rule" />

            <Button
                MinWidth="90"
                Command="{Binding RemoveRuleCommand}"
                Content="Remove rule" />

            <Button
                MinWidth="90"
                Command="{Binding MoveRuleUpCommand}"
                Content="Move up" />

            <Button
                MinWidth="90"
                Command="{Binding MoveRuleDownCommand}"
                Content="Move down" />

            <Button
                MinWidth="90"
                Command="{Binding ClearRulesCommand}"
                Content="Clear all" />

            <Button
                MinWidth="90"
                Content="Cancel" />

            <Button
                MinWidth="90"
                Content="OK" />

        </StackPanel>

    </Grid>
</Window>