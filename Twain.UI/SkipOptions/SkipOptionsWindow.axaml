
<Window
    x:Class="Twain.UI.SkipOptions.SkipOptionsWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="420"
    Height="430"
    CanResize="False"
    ShowInTaskbar="False"
    Title="Skip options"
    Closing="SkipOptionsWindow_Closing"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingMedium}">

        <!-- Instructions -->
        <TextBlock
            Grid.Row="0"
            Text="Select the changes that should cause the page to be skipped:"
            TextWrapping="Wrap" />

        <!-- Select all / none -->
        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="{DynamicResource TwainSpacingLarge}">

            <CheckBox
                x:Name="CheckAll"
                Content="Check _All"
                Click="CheckAll_Click" />

            <CheckBox
                x:Name="CheckNone"
                Content="Check _None"
                Click="CheckNone_Click" />

        </StackPanel>

        <!-- Skip conditions -->
        <Border
            Grid.Row="2"
            Classes="twain-section"
            Margin="0"
            MinHeight="0">

            <Grid
                RowDefinitions="Auto,*"
                RowSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Grid.Row="0"
                    Classes="twain-section-heading"
                    Text="Skip conditions" />

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto">

                    <StackPanel
                        Spacing="{DynamicResource TwainSpacingSmall}">

                        <CheckBox
                            x:Name="BoldTitleOption"
                            Content="Title boldened" />

                        <CheckBox
                            x:Name="BulletedExternalLinkOption"
                            Content="External link bulleted" />

                        <CheckBox
                            x:Name="BadLinksOption"
                            Content="Bad links fixed" />

                        <CheckBox
                            x:Name="UnicodeOption"
                            Content="Unicodification" />

                        <CheckBox
                            x:Name="AutoTagOption"
                            Content="Auto tag changes" />

                        <CheckBox
                            x:Name="HeaderErrorOption"
                            Content="Header error fixed" />

                        <CheckBox
                            x:Name="DefaultSortOption">
                            {{defaultsort}} added
                        </CheckBox>

                        <CheckBox
                            x:Name="UserTalkTemplatesOption"
                            Content="User talk templates subst'd" />

                        <CheckBox
                            x:Name="CitationTemplateDatesOption"
                            Content="Citation templates dates fixed" />

                        <CheckBox
                            x:Name="HumanCategoriesOption"
                            Content="Human category changes" />

                    </StackPanel>

                </ScrollViewer>

            </Grid>
        </Border>

        <!-- Close -->
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right">

            <Button
                Classes="twain-primary-button"
                Content="Close"
                IsDefault="True"
                IsCancel="True"
                Click="CloseButton_Click" />

        </StackPanel>

    </Grid>

</Window>
