<Window
    x:Class="Twain.UI.DBScanner.DatabaseScannerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Twain.UI.Controls"
    Title="Wiki Database Scanner"
    Width="1000"
    Height="700"
    MinWidth="850"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

      <Grid RowDefinitions="Auto,*,Auto"
          Margin="{DynamicResource TwainContentPadding}">
        <!-- Dump selection -->
        <Border Grid.Row="0"
                Classes="twain-section"
                Margin="0,0,0,12">
            <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                <TextBlock Classes="twain-section-heading"
                           Text="Database dump" />
                <Grid ColumnDefinitions="Auto,*,Auto"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Database dump:"
                               VerticalAlignment="Center" />
                    <TextBox Grid.Row="0" Grid.Column="1"
                             Name="DumpLocationTextBox"
                             IsReadOnly="True" />
                    <Button Grid.Row="0" Grid.Column="2"
                            Name="BrowseButton"
                            Classes="twain-command-button"
                            Content="Browse..."
                            Click="BrowseButton_Click" />
                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="Start from:"
                               VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                          ColumnDefinitions="*,Auto,Auto,150"
                          ColumnSpacing="{DynamicResource TwainSpacingMedium}">
                        <TextBox Grid.Column="0" Name="StartFromTextBox"
                                 PlaceholderText="Article title" />
                        <CheckBox Grid.Column="1" Name="IgnoreRedirectsCheckBox"
                                  Content="Ignore redirects" IsChecked="True"
                                  VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Priority:"
                                   VerticalAlignment="Center" />
                        <ComboBox Grid.Column="3" Name="PriorityComboBox"
                                  SelectedIndex="2">
                            <ComboBoxItem Content="Highest" />
                            <ComboBoxItem Content="Above normal" />
                            <ComboBoxItem Content="Normal" />
                            <ComboBoxItem Content="Below normal" />
                            <ComboBoxItem Content="Lowest" />
                        </ComboBox>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Scanner configuration -->
        <!-- Left-side section navigation. Keep ScannerTabs as a TabControl so
             existing SelectedIndex/SelectedItem logic and tab content remain intact. -->
        <TabControl Grid.Row="1"
                    Name="ScannerTabs"
                    TabStripPlacement="Left">
            <TabControl.Styles>
                <!-- Scope the navigation sizing to this scanner only. -->
                <Style Selector="TabItem.scanner-nav-item">
                    <Setter Property="Width" Value="210" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="FontSize" Value="13" />
                    <Setter Property="FontWeight" Value="Normal" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="Margin" Value="0,0,0,2" />
                    <Setter Property="Foreground" Value="{DynamicResource TwainTextPrimaryBrush}" />
                </Style>
                <Style Selector="TabItem.scanner-nav-item:selected">
                    <Setter Property="Background" Value="{DynamicResource TwainSelectionBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </Style>
            </TabControl.Styles>
        
        <TabItem Classes="twain-tab scanner-nav-item" Header="Dump information">
            <StackPanel Margin="{DynamicResource TwainContentPadding}"
                        Spacing="{DynamicResource TwainSpacingMedium}">
                <TextBlock Text="Information read from the selected MediaWiki XML dump."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TwainTextSecondaryBrush}"
                           FontSize="{DynamicResource TwainFontSizeSmall}" />
                <Border Classes="twain-section" MaxWidth="760"
                        HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="Auto,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                          RowSpacing="{DynamicResource TwainSpacingMedium}">
                        <TextBlock Grid.Row="0" Text="Site name:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="0" Grid.Column="1" Name="DumpSiteNameTextBox" IsReadOnly="True" />
                        <TextBlock Grid.Row="1" Text="Base URL:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="1" Grid.Column="1" Name="DumpBaseUrlTextBox" IsReadOnly="True" />
                        <TextBlock Grid.Row="2" Text="Generator:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="2" Grid.Column="1" Name="DumpGeneratorTextBox" IsReadOnly="True" />
                        <TextBlock Grid.Row="3" Text="Case:" VerticalAlignment="Center" />
                        <TextBox Grid.Row="3" Grid.Column="1" Name="DumpCaseTextBox" IsReadOnly="True" />
                    </Grid>
                </Border>
            </StackPanel>
        </TabItem>

        <TabItem Classes="twain-tab scanner-nav-item" Header="Text">

            <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Text="Filter articles by text content, with optional regular-expression matching."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}" />
                    <Border Classes="twain-section"
                            HorizontalAlignment="Stretch">
                        <Grid 
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    RowSpacing="{DynamicResource TwainSpacingMedium}">

                <CheckBox Grid.Row="0"
                            Grid.Column="0"
                            Name="ArticleContainsCheckBox"
                            Content="Contains:"
                            VerticalAlignment="Center"
                            IsCheckedChanged="ArticleContainsCheckBox_IsCheckedChanged" />

                <TextBox Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="ArticleContainsTextBox"
                            IsEnabled="False" />

                <CheckBox Grid.Row="1"
                            Grid.Column="0"
                            Name="ArticleDoesNotContainCheckBox"
                            Content="Not contains:"
                            VerticalAlignment="Center"
                            IsCheckedChanged="ArticleDoesNotContainCheckBox_IsCheckedChanged" />

                <TextBox Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="ArticleDoesNotContainTextBox"
                            IsEnabled="False" />

                <CheckBox Grid.Row="2"
                            Grid.Column="1"
                            Name="ArticleRegexCheckBox"
                            Content="Regex"
                            IsCheckedChanged="ArticleRegexCheckBox_IsCheckedChanged" />

                <CheckBox Grid.Row="2"
                            Grid.Column="2"
                            Name="ArticleSinglelineCheckBox"
                            Content="Singleline"
                            IsEnabled="False" />

                <CheckBox Grid.Row="3"
                            Grid.Column="1"
                            Name="ArticleCaseSensitiveCheckBox"
                            Content="Case sensitive" />

                <CheckBox Grid.Row="3"
                            Grid.Column="2"
                            Name="ArticleMultilineCheckBox"
                            Content="Multiline"
                            IsEnabled="False" />

                <CheckBox Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="IgnoreCommentsCheckBox"
                            Content="Ignore &lt;!-- comments --&gt;" />

            </Grid>
                </Border>
            </StackPanel>
        </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Title">
                <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Text="Filter articles by title text or a regular expression."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}" />
                    <Border Classes="twain-section"
                            HorizontalAlignment="Stretch">
                        <Grid 
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <CheckBox Grid.Row="0"
                              Grid.Column="0"
                              Name="TitleContainsCheckBox"
                              Content="Contains:"
                              VerticalAlignment="Center"
                              IsCheckedChanged="TitleContainsCheckBox_IsCheckedChanged" />

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Name="TitleContainsTextBox"
                             IsEnabled="False" />

                    <CheckBox Grid.Row="1"
                              Grid.Column="0"
                              Name="TitleDoesNotContainCheckBox"
                              Content="Not contains:"
                              VerticalAlignment="Center"
                              IsCheckedChanged="TitleDoesNotContainCheckBox_IsCheckedChanged" />

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Name="TitleDoesNotContainTextBox"
                             IsEnabled="False" />

                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              Name="TitleRegexCheckBox"
                              Content="Regex" />

                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              Name="TitleCaseSensitiveCheckBox"
                              Content="Case sensitive" />

                </Grid>
                    </Border>
            </StackPanel>
        </TabItem>

                <TabItem Classes="twain-tab scanner-nav-item" Header="Namespaces">
                    <Grid Margin="{DynamicResource TwainContentPadding}">
                        <controls:NamespacesControl
                            Name="NamespacesControl"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </Grid>
                </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Revision">
                <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Text="Limit matches to articles with revisions in the selected date range."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}" />
                    <Border Classes="twain-section"
                            HorizontalAlignment="Stretch">
                        <Grid 
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <CheckBox Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Name="SearchDatesCheckBox"
                              Content="Search revision dates"
                              IsCheckedChanged="SearchDatesCheckBox_IsCheckedChanged" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="From:"
                               VerticalAlignment="Center" />

                    <CalendarDatePicker Grid.Row="1"
                                        Grid.Column="1"
                                        Name="DateFromPicker"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Width="180" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="To:"
                               VerticalAlignment="Center" />

                    <CalendarDatePicker Grid.Row="2"
                                        Grid.Column="1"
                                        Name="DateToPicker"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Width="180" />

                </Grid>
                    </Border>
            </StackPanel>
        </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Protection">
                <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Text="Filter articles according to their page protection settings."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}" />
                    <Border Classes="twain-section" MaxWidth="600"
                            HorizontalAlignment="Stretch">
                        <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                            <CheckBox Name="CheckProtectionCheckBox"
                                      Content="Check page protection"
                                      IsCheckedChanged="CheckProtectionCheckBox_IsCheckedChanged" />
                            <controls:EditProtectControl
                                Name="ProtectionControl"
                                IsEnabled="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Properties">
                <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}">
                    <TextBlock Text="Filter articles by character count, link count, and word count."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}" />
                    <Border Classes="twain-section"
                            HorizontalAlignment="Stretch">
                        <Grid 
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Characters:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              Name="LengthComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="0"
                                   Grid.Column="2"
                                   Name="LengthNumericUpDown"
                                   Minimum="1"
                                   Maximum="10000000"
                                   Increment="500"
                                   Value="1000"
                                   Width="100"
                                   IsEnabled="False" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Links:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Name="LinksComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="1"
                                   Grid.Column="2"
                                   Name="LinksNumericUpDown"
                                   Minimum="1"
                                   Maximum="1000"
                                   Value="5"
                                   Width="100"
                                   IsEnabled="False" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Words:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Name="WordsComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="2"
                                   Name="WordsNumericUpDown"
                                   Minimum="0"
                                   Maximum="1000000"
                                   Increment="100"
                                   Value="200"
                                   Width="100"
                                   IsEnabled="False" />

                </Grid>
                    </Border>
            </StackPanel>
        </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Twain checks">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="{DynamicResource TwainContentPadding}"
                                Spacing="{DynamicResource TwainSpacingMedium}"
                                MaxWidth="800" HorizontalAlignment="Left">
                        <TextBlock Text="Select article conditions to identify during a database scan."
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TwainTextSecondaryBrush}"
                                   FontSize="{DynamicResource TwainFontSizeSmall}" />
                        <Border Classes="twain-section">
                            <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">
                                <TextBlock Classes="twain-section-heading" Text="Article conditions" />
                                <Grid ColumnDefinitions="*,*"
                                      RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                                      ColumnSpacing="{DynamicResource TwainSpacingLarge}"
                                      RowSpacing="{DynamicResource TwainSpacingMedium}">
                                    <CheckBox Grid.Row="0" Grid.Column="0"
                                              Name="NoBoldTitleCheckBox"
                                              Content="Has title Twain will embolden" />
                                    <CheckBox Grid.Row="0" Grid.Column="1"
                                              Name="PeopleCategoriesCheckBox"
                                              Content="Human birth/death cats" />
                                    <CheckBox Grid.Row="1" Grid.Column="0"
                                              Name="UnbalancedBracketsCheckBox"
                                              Content="Unbalanced brackets" />
                                    <CheckBox Grid.Row="1" Grid.Column="1"
                                              Name="SimpleLinksCheckBox"
                                              Content="Has simple links" />
                                    <CheckBox Grid.Row="2" Grid.Column="0"
                                              Name="ReorderReferencesCheckBox"
                                              Content="References to reorder" />
                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                              Name="BadLinksCheckBox"
                                              Content="Has bad links Twain will fix" />
                                    <CheckBox Grid.Row="3" Grid.Column="0"
                                              Name="HtmlEntitiesCheckBox"
                                              Content="Has HTML entities" />
                                    <CheckBox Grid.Row="3" Grid.Column="1"
                                              Name="SectionErrorsCheckBox"
                                              Content="Section error" />
                                    <CheckBox Grid.Row="4" Grid.Column="0"
                                              Name="UnbulletedLinksCheckBox"
                                              Content="Unbulleted links" />
                                    <CheckBox Grid.Row="4" Grid.Column="1"
                                              Name="CiteTemplateDatesCheckBox"
                                              Content="Citation dates Twain will fix" />
                                    <CheckBox Grid.Row="5" Grid.Column="0"
                                              Name="TypoCheckBox"
                                              Content="Typos Twain will fix" />
                                    <CheckBox Grid.Row="5" Grid.Column="1"
                                              Name="MissingDefaultSortCheckBox"
                                              Content="Missing DEFAULTSORT" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Classes="twain-tab scanner-nav-item" Header="Results">
                <Grid Margin="{DynamicResource TwainContentPadding}"
                      RowDefinitions="Auto,*"
                      RowSpacing="{DynamicResource TwainSpacingSmall}">
                    <TextBlock Grid.Row="0"
                               Text="Review matching articles or generate a wiki-formatted list."
                               Foreground="{DynamicResource TwainTextSecondaryBrush}"
                               FontSize="{DynamicResource TwainFontSizeSmall}"
                               TextWrapping="Wrap" />

                    <TabControl Grid.Row="1" Classes="twain-tabs">
                        <TabItem Classes="twain-tab" Header="Articles">
                            <Grid Margin="{DynamicResource TwainContentPadding}"
                                  RowDefinitions="Auto,*,Auto,Auto"
                                  RowSpacing="{DynamicResource TwainSpacingMedium}">
                                <TextBlock Grid.Row="0"
                                           Text="Articles matching the selected scan criteria."
                                           Foreground="{DynamicResource TwainTextSecondaryBrush}"
                                           FontSize="{DynamicResource TwainFontSizeSmall}" />

                                <ListBox Grid.Row="1"
                                         Name="ResultsListBox"
                                         MinHeight="120"
                                         SelectionMode="Multiple" />

                                <!-- Scan status is independent of result-list actions. -->
                                <Grid Grid.Row="2"
                                      ColumnDefinitions="Auto,*,Auto"
                                      ColumnSpacing="{DynamicResource TwainSpacingMedium}">
                                    <TextBlock Grid.Column="0"
                                               Name="ResultCountTextBlock"
                                               Text="0 matches"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Grid.Column="1"
                                                 Name="ScanProgressBar"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="0"
                                                 VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Name="ProgressTextBlock"
                                               Text="0%"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <Border Grid.Row="3"
                                        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="{DynamicResource TwainSpacingSmall}">
                                        <Button Classes="twain-command-button"
                                                Name="ClearResultsButton"
                                                Content="Clear"
                                                Click="ClearResultsButton_Click" />
                                        <Button Classes="twain-command-button"
                                                Name="SaveResultsButton"
                                                Content="Save list..."
                                                Click="SaveResultsButton_Click" />
                                        <Button Classes="twain-command-button"
                                                Name="RemoveSelectedButton"
                                                Content="Remove selected"
                                                Click="RemoveSelectedButton_Click" />
                                        <Button Classes="twain-command-button"
                                                Name="CopySelectedButton"
                                                Content="Copy selected"
                                                Click="CopySelectedButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>

                        <TabItem Classes="twain-tab" Header="Wiki list">
                            <Grid Margin="{DynamicResource TwainContentPadding}"
                                  RowDefinitions="Auto,*,Auto"
                                  RowSpacing="{DynamicResource TwainSpacingMedium}">
                                <Border Grid.Row="0" Classes="twain-section">
                                    <StackPanel Spacing="{DynamicResource TwainSpacingSmall}">
                                        <TextBlock Classes="twain-section-heading"
                                                   Text="Wiki list options" />
                                        <TextBlock Text="Format the matching articles as a wiki list."
                                                   Foreground="{DynamicResource TwainTextSecondaryBrush}"
                                                   FontSize="{DynamicResource TwainFontSizeSmall}" />
                                        <WrapPanel Orientation="Horizontal">
                                            <CheckBox Name="WikiHeadingCheckBox"
                                                      Content="Headings"
                                                      Margin="0,0,12,8"
                                                      IsCheckedChanged="WikiHeadingCheckBox_IsCheckedChanged" />
                                            <TextBlock Text="Every:"
                                                       Margin="0,0,8,8"
                                                       VerticalAlignment="Center" />
                                            <NumericUpDown Name="WikiHeadingSpacingNumericUpDown"
                                                           Width="80"
                                                           Margin="0,0,16,8"
                                                           Minimum="1"
                                                           Maximum="1000"
                                                           Value="25"
                                                           IsEnabled="False" />
                                            <CheckBox Name="WikiAlphabeticalHeaderCheckBox"
                                                      Content="Alphabetical headers"
                                                      Margin="0,0,16,8" />
                                            <CheckBox Name="WikiNumberedListCheckBox"
                                                      Content="Numbered list"
                                                      Margin="0,0,16,8"
                                                      IsChecked="True" />
                                            <Button Classes="twain-primary-button"
                                                    Name="GenerateWikiListButton"
                                                    Content="Generate"
                                                    Margin="0,0,0,8"
                                                    Click="GenerateWikiListButton_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <TextBox Grid.Row="1"
                                         Name="WikiListTextBox"
                                         MinHeight="120"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         IsReadOnly="True"
                                         FontFamily="Consolas"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                                <Border Grid.Row="2"
                                        BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,10,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Spacing="{DynamicResource TwainSpacingSmall}">
                                        <Button Classes="twain-command-button"
                                                Name="ClearWikiListButton"
                                                Content="Clear"
                                                Click="ClearWikiListButton_Click" />
                                        <Button Classes="twain-command-button"
                                                Name="CopyWikiListButton"
                                                Content="Copy"
                                                Click="CopyWikiListButton_Click" />
                                        <Button Classes="twain-command-button"
                                                Name="SaveWikiListButton"
                                                Content="Save..."
                                                Click="SaveWikiListButton_Click" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Scanner controls -->
        <Border Grid.Row="2"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0">
        <Grid
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource TwainSpacingSmall}"
              Margin="0,12,0,0">

            <Button Classes="twain-command-button" Name="ResetButton"
                    Content="Reset"
                    Click="ResetButton_Click" />

            <Button Classes="twain-command-button" Grid.Column="1"
                    Name="FilterButton"
                    Content="Filter..."
                    Click="FilterButton_Click" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource TwainSpacingSmall}"
                        VerticalAlignment="Center">

                <TextBlock Text="Limit:"
                           VerticalAlignment="Center" />

                <NumericUpDown Name="ResultLimitNumericUpDown"
                               Minimum="1"
                               Maximum="100000"
                               Value="30000"
                               Width="150" />
            </StackPanel>

            <Button Classes="twain-primary-button" Grid.Column="4"
                    Name="StartButton"
                    Content="Start"
                    Click="StartButton_Click" />
        </Grid>
        </Border>

    </Grid>
</Window>