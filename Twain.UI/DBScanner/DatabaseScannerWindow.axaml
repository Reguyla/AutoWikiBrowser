<Window
    x:Class="Twain.UI.DBScanner.DatabaseScannerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Twain.UI.Controls"
    Title="Wiki Database Scanner"
    Width="1000"
    Height="700"
    MinWidth="850"
    MinHeight="600"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

      <Grid RowDefinitions="Auto,*,Auto"
          Margin="{DynamicResource TwainContentPadding}">
        <!-- Dump selection -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto,Auto"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="{DynamicResource TwainSpacingSmall}"
              RowSpacing="{DynamicResource TwainSpacingSmall}"
              Margin="0,0,0,12">

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Database dump:"
                       VerticalAlignment="Center" />

            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Name="DumpLocationTextBox"
                     IsReadOnly="True" />

            <Button Classes="twain-command-button" Grid.Row="0"
                    Grid.Column="2"
                    Name="BrowseButton"
                    Content="Browse..."
                    Click="BrowseButton_Click" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Start from:"
                       VerticalAlignment="Center" />

            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Grid.ColumnSpan="2"
                  ColumnDefinitions="*,Auto,Auto,150"
                  ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                <TextBox Grid.Column="0"
                         Name="StartFromTextBox"
                         Watermark="Article title" />

                <CheckBox Grid.Column="1"
                          Name="IgnoreRedirectsCheckBox"
                          Content="Ignore redirects"
                          IsChecked="True"
                          VerticalAlignment="Center" />

                <TextBlock Grid.Column="2"
                           Text="Priority:"
                           VerticalAlignment="Center" />

                <ComboBox Grid.Column="3"
                          Name="PriorityComboBox"
                          SelectedIndex="2">
                    <ComboBoxItem Content="Highest" />
                    <ComboBoxItem Content="Above normal" />
                    <ComboBoxItem Content="Normal" />
                    <ComboBoxItem Content="Below normal" />
                    <ComboBoxItem Content="Lowest" />
                </ComboBox>

            </Grid>

        </Grid>

        <!-- Scanner configuration -->
        <TabControl Grid.Row="1"
                    Name="ScannerTabs">
        
        <TabItem Classes="twain-tab" Header="Dump information">
            <Grid Margin="{DynamicResource TwainContentPadding}"
                  RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="Auto,*"
                  ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                  RowSpacing="{DynamicResource TwainSpacingMedium}"
                  MaxWidth="700"
                  HorizontalAlignment="Left">

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Site name:"
                           VerticalAlignment="Center" />

                <TextBox Grid.Row="0"
                         Grid.Column="1"
                         Name="DumpSiteNameTextBox"
                         Width="500"
                         IsReadOnly="True" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Base URL:"
                           VerticalAlignment="Center" />

                <TextBox Grid.Row="1"
                         Grid.Column="1"
                         Name="DumpBaseUrlTextBox"
                         Width="500"
                         IsReadOnly="True" />

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Text="Generator:"
                           VerticalAlignment="Center" />

                <TextBox Grid.Row="2"
                         Grid.Column="1"
                         Name="DumpGeneratorTextBox"
                         Width="500"
                         IsReadOnly="True" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           Text="Case:"
                           VerticalAlignment="Center" />

                <TextBox Grid.Row="3"
                         Grid.Column="1"
                         Name="DumpCaseTextBox"
                         Width="500"
                         IsReadOnly="True" />

            </Grid>
        </TabItem>

        <TabItem Classes="twain-tab" Header="Text">

            <Grid Margin="{DynamicResource TwainContentPadding}"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                    ColumnDefinitions="Auto,*,Auto"
                    ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                    RowSpacing="{DynamicResource TwainSpacingMedium}">

                <CheckBox Grid.Row="0"
                            Grid.Column="0"
                            Name="ArticleContainsCheckBox"
                            Content="Contains:"
                            VerticalAlignment="Center"
                            IsCheckedChanged="ArticleContainsCheckBox_IsCheckedChanged" />

                <TextBox Grid.Row="0"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="ArticleContainsTextBox"
                            IsEnabled="False" />

                <CheckBox Grid.Row="1"
                            Grid.Column="0"
                            Name="ArticleDoesNotContainCheckBox"
                            Content="Not contains:"
                            VerticalAlignment="Center"
                            IsCheckedChanged="ArticleDoesNotContainCheckBox_IsCheckedChanged" />

                <TextBox Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="ArticleDoesNotContainTextBox"
                            IsEnabled="False" />

                <CheckBox Grid.Row="2"
                            Grid.Column="1"
                            Name="ArticleRegexCheckBox"
                            Content="Regex"
                            IsCheckedChanged="ArticleRegexCheckBox_IsCheckedChanged" />

                <CheckBox Grid.Row="2"
                            Grid.Column="2"
                            Name="ArticleSinglelineCheckBox"
                            Content="Singleline"
                            IsEnabled="False" />

                <CheckBox Grid.Row="3"
                            Grid.Column="1"
                            Name="ArticleCaseSensitiveCheckBox"
                            Content="Case sensitive" />

                <CheckBox Grid.Row="3"
                            Grid.Column="2"
                            Name="ArticleMultilineCheckBox"
                            Content="Multiline"
                            IsEnabled="False" />

                <CheckBox Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Name="IgnoreCommentsCheckBox"
                            Content="Ignore &lt;!-- comments --&gt;" />

            </Grid>
        </TabItem>

            <TabItem Classes="twain-tab" Header="Title">
                <Grid Margin="{DynamicResource TwainContentPadding}"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <CheckBox Grid.Row="0"
                              Grid.Column="0"
                              Name="TitleContainsCheckBox"
                              Content="Contains:"
                              VerticalAlignment="Center"
                              IsCheckedChanged="TitleContainsCheckBox_IsCheckedChanged" />

                    <TextBox Grid.Row="0"
                             Grid.Column="1"
                             Name="TitleContainsTextBox"
                             IsEnabled="False" />

                    <CheckBox Grid.Row="1"
                              Grid.Column="0"
                              Name="TitleDoesNotContainCheckBox"
                              Content="Not contains:"
                              VerticalAlignment="Center"
                              IsCheckedChanged="TitleDoesNotContainCheckBox_IsCheckedChanged" />

                    <TextBox Grid.Row="1"
                             Grid.Column="1"
                             Name="TitleDoesNotContainTextBox"
                             IsEnabled="False" />

                    <CheckBox Grid.Row="2"
                              Grid.Column="1"
                              Name="TitleRegexCheckBox"
                              Content="Regex" />

                    <CheckBox Grid.Row="3"
                              Grid.Column="1"
                              Name="TitleCaseSensitiveCheckBox"
                              Content="Case sensitive" />

                </Grid>
            </TabItem>

                <TabItem Classes="twain-tab" Header="Namespaces">
                    <Grid Margin="{DynamicResource TwainContentPadding}">
                        <controls:NamespacesControl
                            Name="NamespacesControl"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top" />
                    </Grid>
                </TabItem>

            <TabItem Classes="twain-tab" Header="Revision">
                <Grid Margin="{DynamicResource TwainContentPadding}"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="Auto,*"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <CheckBox Grid.Row="0"
                              Grid.Column="0"
                              Grid.ColumnSpan="2"
                              Name="SearchDatesCheckBox"
                              Content="Search revision dates"
                              IsCheckedChanged="SearchDatesCheckBox_IsCheckedChanged" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="From:"
                               VerticalAlignment="Center" />

                    <CalendarDatePicker Grid.Row="1"
                                        Grid.Column="1"
                                        Name="DateFromPicker"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Width="180" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="To:"
                               VerticalAlignment="Center" />

                    <CalendarDatePicker Grid.Row="2"
                                        Grid.Column="1"
                                        Name="DateToPicker"
                                        IsEnabled="False"
                                        HorizontalAlignment="Left"
                                        Width="180" />

                </Grid>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Protection">
                <StackPanel Margin="{DynamicResource TwainContentPadding}"
                            Spacing="{DynamicResource TwainSpacingMedium}"
                            MaxWidth="500"
                            HorizontalAlignment="Left">

                    <CheckBox Name="CheckProtectionCheckBox"
                              Content="Check page protection"
                              IsCheckedChanged="CheckProtectionCheckBox_IsCheckedChanged" />

                    <controls:EditProtectControl
                        Name="ProtectionControl"
                        IsEnabled="False" />

                </StackPanel>
            </TabItem>

            <TabItem Classes="twain-tab" Header="Properties">
                <Grid Margin="{DynamicResource TwainContentPadding}"
                      RowDefinitions="Auto,Auto,Auto"
                      ColumnDefinitions="Auto,Auto,Auto"
                      ColumnSpacing="{DynamicResource TwainSpacingMedium}"
                      RowSpacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Text="Characters:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="0"
                              Grid.Column="1"
                              Name="LengthComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="0"
                                   Grid.Column="2"
                                   Name="LengthNumericUpDown"
                                   Minimum="1"
                                   Maximum="10000000"
                                   Increment="500"
                                   Value="1000"
                                   Width="100"
                                   IsEnabled="False" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Text="Links:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="1"
                              Grid.Column="1"
                              Name="LinksComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="1"
                                   Grid.Column="2"
                                   Name="LinksNumericUpDown"
                                   Minimum="1"
                                   Maximum="1000"
                                   Value="5"
                                   Width="100"
                                   IsEnabled="False" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Text="Words:"
                               VerticalAlignment="Center" />

                    <ComboBox Grid.Row="2"
                              Grid.Column="1"
                              Name="WordsComparisonComboBox"
                              SelectedIndex="0"
                              Width="120">
                        <ComboBoxItem Content="not counted" />
                        <ComboBoxItem Content="at least" />
                        <ComboBoxItem Content="at most" />
                    </ComboBox>

                    <NumericUpDown Grid.Row="2"
                                   Grid.Column="2"
                                   Name="WordsNumericUpDown"
                                   Minimum="0"
                                   Maximum="1000000"
                                   Increment="100"
                                   Value="200"
                                   Width="100"
                                   IsEnabled="False" />

                </Grid>
            </TabItem>

            <TabItem Classes="twain-tab" Header="AWB checks">
                <ScrollViewer>
                    <WrapPanel Margin="{DynamicResource TwainContentPadding}"
                                Orientation="Horizontal">

                        <CheckBox Name="NoBoldTitleCheckBox"
                                    Content="Has title AWB will embolden"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="PeopleCategoriesCheckBox"
                                    Content="Human birth/death cats"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="UnbalancedBracketsCheckBox"
                                    Content="Unbalanced brackets"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="SimpleLinksCheckBox"
                                    Content="Has simple links"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="ReorderReferencesCheckBox"
                                    Content="References to reorder"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="BadLinksCheckBox"
                                    Content="Has bad links AWB will fix"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="HtmlEntitiesCheckBox"
                                    Content="Has HTML entities"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="SectionErrorsCheckBox"
                                    Content="Section error"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="UnbulletedLinksCheckBox"
                                    Content="Unbulleted links"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="CiteTemplateDatesCheckBox"
                                    Content="Citation dates AWB will fix"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="TypoCheckBox"
                                    Content="Typos AWB will fix"
                                    Width="240"
                                    Margin="0,0,12,10" />

                        <CheckBox Name="MissingDefaultSortCheckBox"
                                    Content="Missing DEFAULTSORT"
                                    Width="240"
                                    Margin="0,0,12,10" />

                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

             <TabItem Classes="twain-tab" Header="Results">
                <TabControl Margin="{DynamicResource TwainContentPadding}" Classes="twain-tabs">

                    <TabItem Classes="twain-tab" Header="Articles">
                        <Grid Margin="{DynamicResource TwainContentPadding}"
                              RowDefinitions="*,Auto"
                              RowSpacing="{DynamicResource TwainSpacingSmall}">

                            <ListBox Grid.Row="0"
                                     Name="ResultsListBox"
                                     SelectionMode="Multiple" />

                            <Grid Grid.Row="1"
                                  ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="{DynamicResource TwainSpacingMedium}">

                                <TextBlock Grid.Column="0"
                                           Name="ResultCountTextBlock"
                                           Text="0 matches"
                                           VerticalAlignment="Center" />

                                <ProgressBar Grid.Column="1"
                                             Name="ScanProgressBar"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="0"
                                             VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2"
                                           Name="ProgressTextBlock"
                                           Text="0%"
                                           VerticalAlignment="Center" />

                                <Button Classes="twain-command-button" Grid.Column="3"
                                        Name="ClearResultsButton"
                                        Content="Clear"
                                        Click="ClearResultsButton_Click" />

                                <Button Classes="twain-command-button" Grid.Column="4"
                                        Name="SaveResultsButton"
                                        Content="Save list..."
                                        Click="SaveResultsButton_Click" />

                                <Button Classes="twain-command-button" Grid.Column="5"
                                        Name="RemoveSelectedButton"
                                        Content="Remove selected"
                                        Click="RemoveSelectedButton_Click" />

                                <Button Classes="twain-command-button" Grid.Column="6"
                                        Name="CopySelectedButton"
                                        Content="Copy selected"
                                        Click="CopySelectedButton_Click" />

                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Classes="twain-tab" Header="Wiki list">
                        <Grid Margin="{DynamicResource TwainContentPadding}"
                              RowDefinitions="Auto,*,Auto"
                              RowSpacing="{DynamicResource TwainSpacingSmall}">

                            <StackPanel Grid.Row="0"
                                        Orientation="Horizontal"
                                        Spacing="{DynamicResource TwainSpacingMedium}">

                            <CheckBox Name="WikiHeadingCheckBox"
                                      Content="Headings"
                                      IsCheckedChanged="WikiHeadingCheckBox_IsCheckedChanged" />

                                <TextBlock Text="Every:"
                                           VerticalAlignment="Center" />

                                <NumericUpDown Name="WikiHeadingSpacingNumericUpDown"
                                               Width="80"
                                               Minimum="1"
                                               Maximum="1000"
                                               Value="25"
                                               IsEnabled="False" />

                                <CheckBox Name="WikiAlphabeticalHeaderCheckBox"
                                          Content="Alphabetical headers" />

                                <CheckBox Name="WikiNumberedListCheckBox"
                                          Content="Numbered list"
                                          IsChecked="True" />

                                <Button Classes="twain-primary-button" Name="GenerateWikiListButton"
                                        Content="Generate"
                                        Click="GenerateWikiListButton_Click" />

                            </StackPanel>

                            <TextBox Grid.Row="1"
                                     Name="WikiListTextBox"
                                     AcceptsReturn="True"
                                     TextWrapping="NoWrap"
                                     IsReadOnly="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" />

                            <StackPanel Grid.Row="2"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="{DynamicResource TwainSpacingSmall}">

                                <Button Classes="twain-command-button" Name="ClearWikiListButton"
                                        Content="Clear"
                                        Click="ClearWikiListButton_Click" />

                                <Button Classes="twain-command-button" Name="CopyWikiListButton"
                                        Content="Copy"
                                        Click="CopyWikiListButton_Click" />

                                <Button Classes="twain-command-button" Name="SaveWikiListButton"
                                        Content="Save..."
                                        Click="SaveWikiListButton_Click" />

                            </StackPanel>

                        </Grid>
                    </TabItem>

                </TabControl>
            </TabItem>

        </TabControl>

        <!-- Scanner controls -->
        <Grid Grid.Row="2"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto"
              ColumnSpacing="{DynamicResource TwainSpacingSmall}"
              Margin="0,12,0,0">

            <Button Classes="twain-command-button" Name="ResetButton"
                    Content="Reset"
                    Click="ResetButton_Click" />

            <Button Classes="twain-command-button" Grid.Column="1"
                    Name="FilterButton"
                    Content="Filter..."
                    Click="FilterButton_Click" />

            <StackPanel Grid.Column="3"
                        Orientation="Horizontal"
                        Spacing="{DynamicResource TwainSpacingSmall}"
                        VerticalAlignment="Center">

                <TextBlock Text="Limit:"
                           VerticalAlignment="Center" />

                <NumericUpDown Name="ResultLimitNumericUpDown"
                               Minimum="1"
                               Maximum="100000"
                               Value="30000"
                               Width="150" />
            </StackPanel>

            <Button Classes="twain-primary-button" Grid.Column="4"
                    Name="StartButton"
                    Content="Start"
                    Click="StartButton_Click" />
        </Grid>

    </Grid>
</Window>