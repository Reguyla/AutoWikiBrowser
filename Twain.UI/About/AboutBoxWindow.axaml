
<Window
    x:Class="Twain.UI.About.AboutBoxWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="760"
    Height="540"
    MinWidth="700"
    MinHeight="500"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Title="About Twain"
    Background="{DynamicResource TwainApplicationBackgroundBrush}"
    Foreground="{DynamicResource TwainTextPrimaryBrush}">

    <Grid
        Margin="{DynamicResource TwainContentPadding}"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="{DynamicResource TwainSpacingLarge}">

        <!-- Application identity -->
        <Border
            Grid.Row="0"
            Padding="16"
            Background="{DynamicResource TwainSurfaceBrush}"
            BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource TwainControlCornerRadius}">

            <Grid ColumnDefinitions="72,*" ColumnSpacing="16">

                <!-- Twain application logo -->
                <Image
                    Grid.Column="0"
                    Width="64"
                    Height="64"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    Source="avares://Twain.UI/Assets/Twainlogo.ico" />

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="{DynamicResource TwainSpacingSmall}">

                    <TextBlock
                        Text="Twain"
                        FontSize="28"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TwainTextPrimaryBrush}" />

                    <TextBlock
                        x:Name="VersionText"
                        Text="Version"
                        FontSize="14"
                        Foreground="{DynamicResource TwainTextSecondaryBrush}" />

                    <TextBlock
                        Text="A modern, cross-platform evolution of AutoWikiBrowser"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TwainTextSecondaryBrush}" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- About description and feedback -->
        <StackPanel
            Grid.Row="1"
            Spacing="{DynamicResource TwainSpacingSmall}">

            <TextBlock
                Classes="twain-section-heading"
                Text="About Twain" />

            <TextBlock
                Text="Twain builds on the history and open-source work of the AutoWikiBrowser project while providing a modernized application architecture and user interface."
                TextWrapping="Wrap" />

            <!-- Feedback and contributions -->
            <TextBlock
                Classes="twain-section-heading"
                Margin="0,8,0,0"
                Text="Feedback and contributions" />

            <TextBlock
                Text="Help improve Twain by reporting bugs or suggesting new features."
                TextWrapping="Wrap" />

            <StackPanel
                Orientation="Horizontal"
                Spacing="{DynamicResource TwainSpacingMedium}">

                <TextBlock
                    Text="Report a bug (coming soon)"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}" />

                <TextBlock
                    Text="Request an enhancement (coming soon)"
                    Foreground="{DynamicResource TwainTextSecondaryBrush}" />

            </StackPanel>
        </StackPanel>

        <!-- Information panels -->
        <Grid
            Grid.Row="2"
            ColumnDefinitions="*,*"
            ColumnSpacing="{DynamicResource TwainSpacingLarge}">

            <!-- Environment and project history -->
            <Border
                Grid.Column="0"
                Padding="14"
                Background="{DynamicResource TwainSurfaceBrush}"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource TwainControlCornerRadius}">

                <StackPanel Spacing="{DynamicResource TwainSpacingMedium}">

                    <TextBlock
                        Classes="twain-section-heading"
                        Text="Environment" />

                    <TextBlock
                        x:Name="EnvironmentText"
                        TextWrapping="Wrap" />

                    <Border
                        Height="1"
                        Margin="0,8"
                        Background="{DynamicResource TwainBorderSubtleBrush}" />

                    <TextBlock
                        Classes="twain-section-heading"
                        Text="Project history" />

                    <Button
                        x:Name="AutoWikiBrowserButton"
                        HorizontalAlignment="Left"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{DynamicResource TwainAccentBrush}"
                        Click="AutoWikiBrowserButton_Click">

                        <TextBlock
                            Text="AutoWikiBrowser on Wikipedia"
                            Foreground="{DynamicResource TwainAccentBrush}"
                            TextDecorations="Underline" />
                    </Button>

                </StackPanel>
            </Border>

            <!-- License and details -->
            <Border
                Grid.Column="1"
                Padding="14"
                Background="{DynamicResource TwainSurfaceBrush}"
                BorderBrush="{DynamicResource TwainBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource TwainControlCornerRadius}">

                <Grid RowDefinitions="Auto,*" RowSpacing="10">

                    <TextBlock
                        Grid.Row="0"
                        Classes="twain-section-heading"
                        Text="License and details" />

                    <TextBox
                        Grid.Row="1"
                        x:Name="DetailsText"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                </Grid>
            </Border>
        </Grid>

        <!-- Footer -->
        <Grid
            Grid.Row="3"
            RowDefinitions="Auto,Auto"
            RowSpacing="10">

            <Border
                Grid.Row="0"
                Height="1"
                Background="{DynamicResource TwainBorderSubtleBrush}" />

            <Button
                Grid.Row="1"
                Classes="twain-command-button"
                Content="_OK"
                MinWidth="90"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Click="OkButton_Click" />
        </Grid>
    </Grid>
</Window>
