<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>annotations</Nullable>
    <ApplicationIcon>globe.ico</ApplicationIcon>
    <ManifestCertificateThumbprint>AC00F13177F564760CA7C93223447E28AFBED803</ManifestCertificateThumbprint>
    <ManifestKeyFile>AutoWikiBrowser_TemporaryKey.pfx</ManifestKeyFile>
    <GenerateManifests>false</GenerateManifests>
    <SignManifests>false</SignManifests>
    <TargetZone>LocalIntranet</TargetZone>
    <StartupObject>AutoWikiBrowser.Program</StartupObject>
    <Install>true</Install>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>7</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdatePeriodically>false</UpdatePeriodically>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <ApplicationRevision>0</ApplicationRevision>
    <ApplicationVersion>3.0.6.0</ApplicationVersion>
    <UseApplicationTrust>false</UseApplicationTrust>
    <UseWindowsForms>true</UseWindowsForms>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DocumentationFile></DocumentationFile>
    <UseVSHostingProcess>false</UseVSHostingProcess>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DefineConstants>TRACE;RELEASE</DefineConstants>
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>
    <DocumentationFile></DocumentationFile>
    <UseWinFormsOutOfProcDesigner>True</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>
	<ItemGroup>
<Reference Include="Microsoft.mshtml">
  <HintPath>$(WINDIR)\assembly\GAC\Microsoft.mshtml\7.0.3300.0__b03f5f7f11d50a3a\Microsoft.mshtml.dll</HintPath>
  <EmbedInteropTypes>false</EmbedInteropTypes>
  <Private>true</Private>
</Reference>
	</ItemGroup>
  <ItemGroup>
    <Compile Update="AWBWebBrowser.cs" />
    <Compile Update="NudgeTimer.cs">
      <SubType>Component</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Include=".gitignore" />
    <Content Include="globe.ico" />
    <Content Include="Resources\AutoWikiBrowser2.png" />
    <Content Include="Resources\button_bold.png" />
    <Content Include="Resources\button_extlink.png" />
    <Content Include="Resources\Button_hide_comment.png" />
    <Content Include="Resources\button_hr.png" />
    <Content Include="Resources\button_italic.png" />
    <Content Include="Resources\button_link.png" />
    <Content Include="Resources\Button_lower_letter.png" />
    <Content Include="Resources\button_math.png" />
    <Content Include="Resources\button_nowiki.png" />
    <Content Include="Resources\Button_redirect.png" />
    <Content Include="Resources\Button_strike.png" />
    <Content Include="Resources\Button_upper_letter.png" />
  </ItemGroup>
<ItemGroup>
  <ProjectReference Include="..\WikiFunctions\WikiFunctions.csproj" />

  <!-- Build AWBUpdater before copying its output into the AWB directory. -->
  <ProjectReference Include="..\AWBUpdater\AWBUpdater.csproj" ReferenceOutputAssembly="false" />
</ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Remove="Stats.resx" />
    <None Include="Stats.resx">
    <DependentUpon>Stats.cs</DependentUpon>
    </None>
  </ItemGroup>
   <ItemGroup>
	  <EmbeddedResource Update="Preferences.resx">
		  <DependentUpon>Preferences.cs</DependentUpon>
		  <LogicalName>AutoWikiBrowser.MyPreferences.resources</LogicalName>
	  </EmbeddedResource>
   </ItemGroup>
  <Target Name="CopyAwbUpdaterFiles" AfterTargets="Build">
    <ItemGroup>
      <AwbUpdaterFiles Include="$(MSBuildProjectDirectory)\..\AWBUpdater\bin\$(Configuration)\$(TargetFramework)\AWBUpdater.*" />
    </ItemGroup>

    <Error Condition="'@(AwbUpdaterFiles)' == ''" Text="AWBUpdater output files were not found in the expected build directory." />

    <Copy SourceFiles="@(AwbUpdaterFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
