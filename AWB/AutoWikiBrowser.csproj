<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>annotations</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <StartupObject>AutoWikiBrowser.Program</StartupObject>
    <ApplicationIcon>globe.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|AnyCPU'">
    <UseWinFormsOutOfProcDesigner>true</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE</DefineConstants>

    <!--
      TODO: Determine whether explicit serialization assembly generation still
      provides any benefit for this .NET 10 project. Remove it separately after
      confirming that the Release build and runtime behavior remain unchanged.
    -->
    <GenerateSerializationAssemblies>Auto</GenerateSerializationAssemblies>

    <UseWinFormsOutOfProcDesigner>true</UseWinFormsOutOfProcDesigner>
  </PropertyGroup>

  <ItemGroup>
    <!--
      TODO: Remove the legacy Microsoft.mshtml dependency after all remaining
      Internet Explorer DOM functionality has been migrated to WebView2 or
      another supported implementation.

      This reference uses a specific GAC path and may not be available on every
      development or build environment.
    -->
    <Reference Include="Microsoft.mshtml">
      <HintPath>$(WINDIR)\assembly\GAC\Microsoft.mshtml\7.0.3300.0__b03f5f7f11d50a3a\Microsoft.mshtml.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="NudgeTimer.cs">
      <SubType>Component</SubType>
    </Compile>

    <Compile Update="UserSettings.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Include="globe.ico" />
    <Content Include="Resources\AutoWikiBrowser2.png" />
    <Content Include="Resources\button_bold.png" />
    <Content Include="Resources\button_extlink.png" />
    <Content Include="Resources\Button_hide_comment.png" />
    <Content Include="Resources\button_hr.png" />
    <Content Include="Resources\button_italic.png" />
    <Content Include="Resources\button_link.png" />
    <Content Include="Resources\Button_lower_letter.png" />
    <Content Include="Resources\button_math.png" />
    <Content Include="Resources\button_nowiki.png" />
    <Content Include="Resources\Button_redirect.png" />
    <Content Include="Resources\Button_strike.png" />
    <Content Include="Resources\Button_upper_letter.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Twain.Core\Twain.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />

    <!--
      TODO: Review the remaining Newtonsoft.Json usage and migrate suitable
      code to System.Text.Json before removing this dependency.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <!--
    Stats.resx is kept beside Stats.cs for project organization but must not be
    compiled as a normal embedded WinForms resource.
  -->
  <ItemGroup>
    <EmbeddedResource Remove="Stats.resx" />

    <None Include="Stats.resx">
      <DependentUpon>Stats.cs</DependentUpon>
    </None>
  </ItemGroup>

  <!--
    Preserve the legacy logical resource name expected by the Preferences form.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Preferences.resx">
      <DependentUpon>Preferences.cs</DependentUpon>
      <LogicalName>AutoWikiBrowser.MyPreferences.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>